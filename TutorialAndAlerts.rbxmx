<roblox xmlns:xmime="http://www.w3.org/2005/05/xmlmime" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://www.roblox.com/roblox.xsd" version="4">
	<Item class="Folder" referent="RBX0">
		<Properties><string name="Name">TutorialAndAlerts</string></Properties>
		<Item class="ModuleScript" referent="RBX1">
			<Properties>
				<string name="Name">Config</string>
				<ProtectedString name="Source"><![CDATA[--[[
	Tutorial and notification settings. Edit the text and numbers here.

	TUTORIAL STEPS
	The guided tutorial shows Steps in order, one card at a time. A step can have:

	  Title      Heading of the card.
	  Icon       A big emoji, or an image like "rbxassetid://123456".
	  Body       The explanation (rich text: <b>bold</b>, <i>italic</i>, <font color="#ffde28">colour</font>).
	             Use { Keyboard = "...", Touch = "...", Gamepad = "..." } for different text on
	             each device. Missing devices fall back to Keyboard.
	             {Islands} is replaced with the island list below, {Tool} with the pistol name.
	  Keys       Key hints drawn as keycaps, e.g. { "W", "A", "S", "D" } (per-device table allowed).
	  Tip        A short extra hint shown in gold under the explanation.
	  Highlight  Something to point at while the step is open:
	               { Gui = { "bag", "inventory" } }      a button on screen whose name or text contains a word
	               { Tag = "JadeGoblin" }                 the nearest thing with this CollectionService tag
	               { Path = { "JadeJungle", "GoblinSpawns" } } a part (or the first part in a folder) in Workspace
	  Goal       Something the player does to finish the step. It gets ticked off and the
	             tutorial moves on by itself. Players can always press Next to skip ahead.
	               { Type = "Move", Distance = 30 }       walk this many studs
	               { Type = "Jump" }
	               { Type = "Look", Degrees = 120 }       turn the camera
	               { Type = "Equip", Tool = "Pistol" }    hold a tool (leave Tool out for any tool)
	               { Type = "Open", Gui = { "bag" } }     open a window whose name contains a word
	               { Type = "Reach", Tag = "JadeGoblin", Radius = 40 }  (or Path = { ... })
	               { Type = "Level", Level = 2 }
	             Add Text = "..." to change how the goal is worded.
	  OnlyIf     Skip the step when something isn't in your game, e.g. { Tool = "Pistol" },
	             { Tag = "JadeGoblin" }, { Gui = { "bag" } } or { Path = { ... } }.
	  Dim        true/false: darken the screen behind the card. By default it darkens for
	             reading steps and stays clear for steps where the player has to move.
]]

local Config = {}

Config.Tutorial = {
	Enabled = true,
	ShowOnFirstJoin = true, -- open automatically for players who haven't finished it
	SaveProgress = true, -- remember (in a DataStore) who finished it, so it only shows once
	DataStoreName = "TutorialAndAlerts",
	StartDelay = 2, -- seconds after spawning before it opens
	AutoAdvanceDelay = 1.2, -- seconds to wait after a goal is done before moving on
	HelpButton = true, -- the round "?" button on the left that replays the tutorial
	HelpButtonPosition = UDim2.new(0, 14, 0.5, 0), -- move it if it covers your own buttons

	-- Hide the game's old tutorial screen so two tutorials don't show at once.
	-- Any ScreenGui whose name contains one of these words is turned off.
	HideOldTutorial = true,
	OldTutorialNames = { "tutorial" },
}

Config.ToolName = "Pistol" -- used for {Tool} in the text below

Config.Steps = {
	{
		Title = "Welcome, adventurer!",
		Icon = "👋",
		Body = "This short guide shows you how to play, one thing at a time.\n\n"
			.. "Some steps ask you to try something. A <b>goal box</b> shows what to do, and it ticks off "
			.. "when you've done it. Then the guide moves on by itself.",
		Tip = "Press Next and Back to move between steps, or X to skip. The ? button on the left replays this guide.",
	},
	{
		Title = "Walking",
		Icon = "🏃",
		Body = {
			Keyboard = "Hold <b>W</b> to walk forward. <b>A</b> and <b>D</b> walk left and right, <b>S</b> walks backwards. "
				.. "The arrow keys work too.\n\nYou always walk the way the camera faces.",
			Touch = "Put your thumb on the bottom-left of the screen and drag. A <b>joystick</b> appears, "
				.. "and you walk the way you drag it.\n\nYou always walk the way the camera faces.",
			Gamepad = "Push the <b>left stick</b> to walk. Push it a little to walk slowly, or all the way to run.",
		},
		Keys = { Keyboard = { "W", "A", "S", "D" }, Gamepad = { "Left stick" } },
		Goal = { Type = "Move", Distance = 30, Text = "Walk 30 studs in any direction" },
		Tip = "The goal bar fills up as you walk.",
	},
	{
		Title = "Jumping",
		Icon = "🦘",
		Body = {
			Keyboard = "Press <b>Space</b> to jump. Jump onto ledges, over rocks and across gaps. "
				.. "Hold <b>Space</b> to keep jumping.",
			Touch = "Tap the round <b>jump button</b> in the bottom-right corner to jump onto ledges, "
				.. "over rocks and across gaps.",
			Gamepad = "Press <b>A</b> to jump onto ledges, over rocks and across gaps.",
		},
		Keys = { Keyboard = { "Space" }, Gamepad = { "A" } },
		Goal = { Type = "Jump", Text = "Jump once" },
	},
	{
		Title = "Looking around",
		Icon = "🎥",
		Body = {
			Keyboard = "Hold the <b>right mouse button</b> and move the mouse to turn the camera. "
				.. "Scroll the <b>mouse wheel</b> to zoom in and out.\n\nZoom all the way in for first-person view.",
			Touch = "Drag one finger across an empty part of the screen to turn the camera. "
				.. "<b>Pinch</b> with two fingers to zoom in and out.",
			Gamepad = "Push the <b>right stick</b> to turn the camera. Press it in to zoom.",
		},
		Keys = { Keyboard = { "Right mouse", "Mouse wheel" }, Gamepad = { "Right stick" } },
		Goal = { Type = "Look", Degrees = 120, Text = "Turn the camera around" },
	},
	{
		Title = "Your {Tool}",
		Icon = "🔫",
		OnlyIf = { Tool = "Pistol" },
		Body = {
			Keyboard = "Your {Tool} is in the <b>hotbar</b> at the bottom of the screen. Press <b>1</b> or click it to take it out.\n\n"
				.. "<b>Click</b> to shoot at the middle of the crosshair. The box in the bottom-right shows how many "
				.. "bullets are left. Press <b>R</b> to reload.",
			Touch = "Your {Tool} is in the <b>hotbar</b> at the bottom of the screen. Tap it to take it out.\n\n"
				.. "<b>Tap</b> where you want to shoot. When you run out of bullets, tap the <b>RELOAD</b> button.",
			Gamepad = "Your {Tool} is in the <b>hotbar</b>. Press <b>LB</b> or <b>RB</b> to pick it, then <b>RT</b> to shoot.",
		},
		Keys = { Keyboard = { "1", "Click", "R" }, Gamepad = { "LB / RB", "RT" } },
		Goal = { Type = "Equip", Tool = "Pistol", Text = "Take out your {Tool}" },
		Tip = "Headshots do double damage.",
	},
	{
		Title = "Goblins",
		Icon = "👺",
		OnlyIf = { Tag = "JadeGoblin" },
		Highlight = { Tag = "JadeGoblin" },
		Body = "Goblins live in the <b>Jade Jungle</b>. The gold arrow points to the nearest one.\n\n"
			.. "When you get close, they run at you and swing their swords. Keep your distance and shoot them. "
			.. "Defeated goblins come back after a while.",
		Goal = { Type = "Reach", Tag = "JadeGoblin", Radius = 60, Text = "Get close to a goblin" },
		Tip = "Watch your health bar. If it gets low, back away and let it refill.",
	},
	{
		Title = "Your bag",
		Icon = "🎒",
		OnlyIf = { Gui = { "bag", "inventory", "backpack" } },
		Highlight = { Gui = { "bag", "inventory", "backpack" } },
		Body = "This button opens your <b>Bag</b>. It holds everything you collect.\n\n"
			.. "Click an item to see what it does. Use or equip it from there.",
		Goal = { Type = "Open", Gui = { "bag", "inventory", "backpack" }, Text = "Open your bag" },
	},
	{
		Title = "Quests",
		Icon = "📜",
		OnlyIf = { Gui = { "quest" } },
		Highlight = { Gui = { "quest" } },
		Body = "This button opens <b>Quests</b>. Each quest is a small job, like defeating goblins or collecting items.\n\n"
			.. "The bar on each quest shows your progress. When it fills, claim the reward to get "
			.. "<font color=\"#ffde28\"><b>XP</b></font>.",
		Goal = { Type = "Open", Gui = { "quest" }, Text = "Open your quests" },
	},
	{
		Title = "Levels and XP",
		Icon = "⭐",
		Body = "You earn <font color=\"#ffde28\"><b>XP</b></font> from quests and from defeating enemies. "
			.. "When you have enough, you <b>level up</b>, and a big banner shows what you unlocked.\n\n"
			.. "Higher levels unlock stronger gear and new places to explore.",
		Tip = "Quests usually give more XP than fighting.",
	},
	{
		Title = "Islands",
		Icon = "🏝",
		Body = "The world is made of <b>islands</b>. You unlock new ones as you level up:\n\n{Islands}\n\n"
			.. "When a new island opens, a banner tells you how to get there.",
	},
	{
		Title = "You're ready!",
		Icon = "🏆",
		Body = "That's everything you need to get started. Go take on the goblins and do some quests.\n\n"
			.. "You can replay this guide anytime with the <b>?</b> button on the left of the screen.",
	},
}

--------------------------------------------------------------------------------
-- Level and island notifications
--------------------------------------------------------------------------------

-- Where the player's level is found. The scripts look for, in order:
--   an attribute on the player with one of these names
--   a number value with one of these names in leaderstats
--   a number value with one of these names anywhere else under the player (e.g. a Data folder)
Config.LevelNames = { "Level", "Lvl", "LV" }

-- Islands and the level that unlocks each. When a player reaches the level, an
-- "Island unlocked" banner shows. Replace these with your game's islands.
-- Image is optional ("rbxassetid://..."), and Hint says how to get there.
Config.Islands = {
	{ Name = "Jade Jungle", Level = 1, Description = "Overgrown ruins full of goblins." },
	-- { Name = "Frost Peaks", Level = 10, Description = "Icy cliffs and snow trolls.", Image = "" },
	-- { Name = "Ember Isle", Level = 25, Description = "A volcano that never stops smoking." },
}
Config.IslandHint = "Open the map or use a portal to travel there."

-- Islands are also detected when your game unlocks them some other way:
--   an attribute on the player with "island" in its name set to true, e.g. "Island_FrostPeaks"
--   a value in a folder under the player with "island" in its name, e.g. UnlockedIslands > "Frost Peaks"
-- Server scripts can also show the banner themselves; see the Notify module.
Config.DetectIslands = true

-- Extra lines shown on the level-up banner when a player reaches these levels.
Config.LevelRewards = {
	-- [5] = "New quests at the jungle temple",
	-- [10] = "Frost Peaks unlocked",
}

-- Data saved by your game usually loads a few seconds after joining. Level and
-- island changes in this window are treated as loading, not as a level up.
Config.JoinGraceSeconds = 8

Config.BannerTime = 4 -- seconds a level-up / island banner stays up
Config.ToastTime = 4 -- seconds a small notification stays up
Config.Confetti = true

-- Sound IDs, e.g. "rbxassetid://123456" from the Creator Store. "" = silent.
Config.Sounds = {
	LevelUp = "",
	Island = "",
	Toast = "",
	StepDone = "",
}
Config.Volume = 0.6

return Config
]]></ProtectedString>
			</Properties>
		</Item>
		<Item class="ModuleScript" referent="RBX2">
			<Properties>
				<string name="Name">Style</string>
				<ProtectedString name="Source"><![CDATA[--[[
	Shared look for the tutorial and the notifications: the same dark navy,
	red and gold as the Quests window, plus small helpers for building UI.
]]

local SoundService = game:GetService("SoundService")

local Style = {}

Style.Colors = {
	WindowTop = Color3.fromRGB(14, 20, 34),
	WindowBottom = Color3.fromRGB(6, 9, 16),
	WindowBorder = Color3.fromRGB(122, 8, 8),
	HeaderTop = Color3.fromRGB(176, 12, 12),
	HeaderBottom = Color3.fromRGB(98, 0, 0),
	CardTop = Color3.fromRGB(18, 30, 52),
	CardBottom = Color3.fromRGB(5, 9, 18),
	CardBorder = Color3.fromRGB(40, 60, 94),
	Slot = Color3.fromRGB(8, 10, 15),
	SlotBorder = Color3.fromRGB(44, 48, 60),
	ButtonTop = Color3.fromRGB(36, 36, 40),
	ButtonBottom = Color3.fromRGB(14, 14, 16),
	ButtonBorder = Color3.fromRGB(64, 64, 70),
	GoldTop = Color3.fromRGB(255, 226, 82),
	GoldBottom = Color3.fromRGB(214, 146, 10),
	GoldBorder = Color3.fromRGB(120, 72, 0),
	Track = Color3.fromRGB(18, 20, 24),
	Text = Color3.new(1, 1, 1),
	SubText = Color3.fromRGB(196, 202, 214),
	DarkText = Color3.fromRGB(40, 24, 0),
	Gold = Color3.fromRGB(255, 222, 40),
	Green = Color3.fromRGB(70, 214, 96),
	Close = Color3.fromRGB(236, 22, 34),
	Outline = Color3.new(0, 0, 0),
}

local FONT_FAMILY = "rbxasset://fonts/families/Montserrat.json"
Style.FontTitle = Font.new(FONT_FAMILY, Enum.FontWeight.ExtraBold)
Style.FontBold = Font.new(FONT_FAMILY, Enum.FontWeight.Bold)
Style.FontBody = Font.new(FONT_FAMILY, Enum.FontWeight.SemiBold)

function Style.make(class, props, parent)
	local inst = Instance.new(class)
	for k, v in props do
		inst[k] = v
	end
	inst.Parent = parent
	return inst
end

local make = Style.make

function Style.gradient(gui, top, bottom, rotation)
	gui.BackgroundColor3 = Color3.new(1, 1, 1) -- the gradient tints this
	return make("UIGradient", { Rotation = rotation or 90, Color = ColorSequence.new(top, bottom) }, gui)
end

function Style.border(gui, color, thickness)
	return make("UIStroke", { Color = color, Thickness = thickness, ApplyStrokeMode = Enum.ApplyStrokeMode.Border }, gui)
end

function Style.corner(gui, radius)
	return make("UICorner", { CornerRadius = radius or UDim.new(0, 8) }, gui)
end

function Style.label(props, parent)
	local defaults = {
		BackgroundTransparency = 1,
		FontFace = Style.FontBody,
		TextColor3 = Style.Colors.Text,
		TextSize = 16,
		TextWrapped = true,
		RichText = true,
	}
	for k, v in props do
		defaults[k] = v
	end
	return make("TextLabel", defaults, parent)
end

-- An emoji/text icon, or an image when given an asset id.
function Style.icon(icon, props, parent)
	if typeof(icon) == "string" and (icon:find("rbxassetid://", 1, true) or icon:find("rbxasset://", 1, true) or icon:find("http", 1, true)) then
		local image = make("ImageLabel", { BackgroundTransparency = 1, Image = icon, ScaleType = Enum.ScaleType.Fit }, parent)
		for k, v in props do
			if k ~= "TextSize" then
				image[k] = v
			end
		end
		return image
	end
	local text = Style.label({ Text = icon or "", TextScaled = true, RichText = false, FontFace = Style.FontBold }, parent)
	for k, v in props do
		text[k] = v
	end
	return text
end

-- A button with the dark (or gold) gradient look. Returns the button.
function Style.button(text, gold, props, parent)
	local c = Style.Colors
	local button = make("TextButton", {
		Text = text,
		FontFace = Style.FontTitle,
		TextSize = 16,
		TextColor3 = gold and c.DarkText or c.Text,
		AutoButtonColor = true,
		BorderSizePixel = 0,
	}, parent)
	for k, v in props do
		button[k] = v
	end
	Style.gradient(button, gold and c.GoldTop or c.ButtonTop, gold and c.GoldBottom or c.ButtonBottom)
	Style.border(button, gold and c.GoldBorder or c.ButtonBorder, 2)
	Style.corner(button, UDim.new(0, 6))
	return button
end

-- Repaints a button made by Style.button as gold or dark.
function Style.setGold(button, gold)
	local c = Style.Colors
	local g = button:FindFirstChildOfClass("UIGradient")
	if g then
		g.Color = ColorSequence.new(gold and c.GoldTop or c.ButtonTop, gold and c.GoldBottom or c.ButtonBottom)
	end
	local s = button:FindFirstChildOfClass("UIStroke")
	if s then
		s.Color = gold and c.GoldBorder or c.ButtonBorder
	end
	button.TextColor3 = gold and c.DarkText or c.Text
end

local soundCache = {}

function Style.playSound(id, volume)
	if not id or id == "" then
		return
	end
	local sound = soundCache[id]
	if not sound then
		sound = make("Sound", { SoundId = id, Volume = volume or 0.6 }, SoundService)
		soundCache[id] = sound
	end
	SoundService:PlayLocalSound(sound)
end

return Style
]]></ProtectedString>
			</Properties>
		</Item>
		<Item class="ModuleScript" referent="RBX3">
			<Properties>
				<string name="Name">PlayerStats</string>
				<ProtectedString name="Source"><![CDATA[--[[
	Finds the player's level and reports when it changes. The level can be an
	attribute on the player, a value in leaderstats, or a value anywhere else
	under the player (e.g. a Data folder). Names come from Config.LevelNames.
]]

local PlayerStats = {}

local function matches(name, names)
	name = name:lower()
	for _, n in names do
		if name == n:lower() then
			return true
		end
	end
	return false
end

local function numberOf(value)
	if value:IsA("IntValue") or value:IsA("NumberValue") then
		return value.Value
	elseif value:IsA("StringValue") then
		return tonumber(value.Value)
	end
	return nil
end

-- Calls onChange(newLevel, oldLevel) every time the level changes. oldLevel is
-- nil the first time the level is found. Returns a function giving the
-- current level (nil until it's found).
function PlayerStats.watchLevel(player, names, onChange)
	local level = nil
	local found = false

	local function set(new)
		new = tonumber(new)
		if new == nil or new == level then
			return
		end
		local old = level
		level = new
		onChange(new, old)
	end

	local search

	local function useAttribute(name)
		found = true
		player:GetAttributeChangedSignal(name):Connect(function()
			set(player:GetAttribute(name))
		end)
		set(player:GetAttribute(name))
	end

	local function useValue(value)
		found = true
		local changed = value.Changed:Connect(function()
			set(numberOf(value))
		end)
		value.AncestryChanged:Connect(function()
			if not value:IsDescendantOf(player) then
				changed:Disconnect()
				found = false
				search()
			end
		end)
		set(numberOf(value))
	end

	function search()
		if found then
			return
		end
		for name, value in player:GetAttributes() do
			if matches(name, names) and tonumber(value) then
				useAttribute(name)
				return
			end
		end
		local leaderstats = player:FindFirstChild("leaderstats")
		if leaderstats then
			for _, value in leaderstats:GetChildren() do
				if value:IsA("ValueBase") and matches(value.Name, names) and numberOf(value) then
					useValue(value)
					return
				end
			end
		end
		for _, value in player:GetDescendants() do
			if value:IsA("ValueBase") and matches(value.Name, names) and numberOf(value) and not value:FindFirstAncestorOfClass("PlayerGui") then
				useValue(value)
				return
			end
		end
	end

	player.AttributeChanged:Connect(function(name)
		if not found and matches(name, names) then
			search()
		end
	end)
	player.DescendantAdded:Connect(function(value)
		if not found and value:IsA("ValueBase") and matches(value.Name, names) and not value:FindFirstAncestorOfClass("PlayerGui") then
			task.defer(search) -- let the folder it's in finish replicating first
		end
	end)
	search()

	return function()
		return level
	end
end

return PlayerStats
]]></ProtectedString>
			</Properties>
		</Item>
		<Item class="ModuleScript" referent="RBX4">
			<Properties>
				<string name="Name">Notify</string>
				<ProtectedString name="Source"><![CDATA[--[[
	Show notifications from your own scripts.

	From a server Script:
		local Notify = require(game.ReplicatedStorage.TutorialAndAlerts.Notify)

		Notify.IslandUnlocked(player, "Frost Peaks")               -- island banner; details come from Config.Islands
		Notify.IslandUnlocked(player, "Frost Peaks", "Icy cliffs")  -- or give your own description
		Notify.LevelUp(player, 12)                                   -- level-up banner (normally automatic)
		Notify.Toast(player, "Quest complete", "+50 XP")             -- small pop-up in the corner
		Notify.ToastAll("Double XP", "For the next 10 minutes!")     -- small pop-up for everyone
		Notify.ShowTutorial(player)                                  -- open the tutorial from the start

	From a LocalScript the same calls work for the local player.
	The same banner never shows twice, so it's safe to call these even when
	the automatic level / island detection also spots the change.
]]

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")

local folder = script.Parent
local remote, localEvent

if RunService:IsServer() then
	remote = folder:FindFirstChild("AlertRemote") or Instance.new("RemoteEvent")
	remote.Name = "AlertRemote"
	remote.Parent = folder
	localEvent = folder:FindFirstChild("LocalAlert") or Instance.new("BindableEvent")
	localEvent.Name = "LocalAlert"
	localEvent.Parent = folder
else
	remote = folder:WaitForChild("AlertRemote")
	localEvent = folder:WaitForChild("LocalAlert")
end

local function send(player, kind, ...)
	if RunService:IsServer() then
		remote:FireClient(player, kind, ...)
	elseif player == Players.LocalPlayer then
		localEvent:Fire(kind, ...)
	end
end

local Notify = {}

Notify.Remote = remote
Notify.LocalEvent = localEvent

function Notify.LevelUp(player, level)
	send(player, "LevelUp", level)
end

function Notify.IslandUnlocked(player, islandName, description)
	send(player, "Island", islandName, description)
end

function Notify.Toast(player, title, text)
	send(player, "Toast", title, text)
end

function Notify.ToastAll(title, text)
	if RunService:IsServer() then
		remote:FireAllClients("Toast", title, text)
	else
		localEvent:Fire("Toast", title, text)
	end
end

function Notify.ShowTutorial(player)
	send(player, "ShowTutorial")
end

return Notify
]]></ProtectedString>
			</Properties>
		</Item>
		<Item class="Script" referent="RBX5">
			<Properties>
				<string name="Name">TutorialServer</string>
				<token name="RunContext">1</token>
				<ProtectedString name="Source"><![CDATA[--[[
	Tutorial server: remembers which players have finished the tutorial (so it
	only opens on their first visit) and sets up the notification remote.
	This is a Script with RunContext = Server, so it runs from ReplicatedStorage.
]]

local DataStoreService = game:GetService("DataStoreService")
local Players = game:GetService("Players")

local folder = script.Parent
local Config = require(folder:WaitForChild("Config"))
local Notify = require(folder:WaitForChild("Notify")) -- creates the remotes

local DONE = "TutorialDone" -- player attribute the client reads

local store = nil
if Config.Tutorial.SaveProgress then
	local ok, result = pcall(function()
		return DataStoreService:GetDataStore(Config.Tutorial.DataStoreName)
	end)
	if ok then
		store = result
	else
		warn("[TutorialAndAlerts] can't save tutorial progress: " .. tostring(result))
	end
end

local warned = false
local function storeWarn(err)
	if not warned then
		warned = true
		-- In Studio this usually means "Enable Studio Access to API Services" is off.
		warn("[TutorialAndAlerts] DataStore error, the tutorial will show every visit: " .. tostring(err))
	end
end

local function key(player)
	return "u" .. player.UserId
end

local function onPlayerAdded(player)
	local done = false
	if store then
		local ok, result = pcall(function()
			return store:GetAsync(key(player))
		end)
		if ok then
			done = result == true
		else
			storeWarn(result)
		end
	end
	if player.Parent then
		player:SetAttribute(DONE, done)
	end
end

Players.PlayerAdded:Connect(onPlayerAdded)
for _, player in Players:GetPlayers() do
	task.spawn(onPlayerAdded, player)
end

Notify.Remote.OnServerEvent:Connect(function(player, kind)
	if kind ~= "TutorialDone" or player:GetAttribute(DONE) == true then
		return
	end
	player:SetAttribute(DONE, true)
	if store then
		local ok, err = pcall(function()
			store:SetAsync(key(player), true)
		end)
		if not ok then
			storeWarn(err)
		end
	end
end)
]]></ProtectedString>
			</Properties>
		</Item>
		<Item class="Script" referent="RBX6">
			<Properties>
				<string name="Name">Tutorial</string>
				<token name="RunContext">2</token>
				<ProtectedString name="Source"><![CDATA[--[[
	Guided tutorial. Shows one card at a time with a picture, a clear
	explanation, key hints for the player's device, and often a goal to try
	("Walk 30 studs", "Open your bag") that ticks off by itself. While a step is
	open it can light up a button on screen or point a gold arrow and trail at
	something in the world.

	It opens on a player's first visit (the server remembers who finished it),
	and the round "?" button on the left replays it. Steps live in Config.Steps.
	This is a Script with RunContext = Client, so it runs from ReplicatedStorage.
]]

local CollectionService = game:GetService("CollectionService")
local GuiService = game:GetService("GuiService")
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")
local UserInputService = game:GetService("UserInputService")
local Workspace = game:GetService("Workspace")

local folder = script.Parent
local Config = require(folder:WaitForChild("Config"))
local Style = require(folder:WaitForChild("Style"))
local PlayerStats = require(folder:WaitForChild("PlayerStats"))
local Notify = require(folder:WaitForChild("Notify"))

local settings = Config.Tutorial
if not settings.Enabled then
	return
end

local player = Players.LocalPlayer
local playerGui = player:WaitForChild("PlayerGui")
local C = Style.Colors
local make = Style.make

local CARD_WIDTH = 540
local SPOT_PAD = 8 -- gap between a highlighted button and the gold ring

local gui = make("ScreenGui", {
	Name = "GuideOverlay",
	ResetOnSpawn = false,
	IgnoreGuiInset = true,
	DisplayOrder = 15,
	ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
}, playerGui)

local getLevel = PlayerStats.watchLevel(player, Config.LevelNames, function() end)

local function tween(inst, time, props, style, direction)
	local t = TweenService:Create(inst, TweenInfo.new(time, style or Enum.EasingStyle.Quad, direction or Enum.EasingDirection.Out), props)
	t:Play()
	return t
end

local function camera()
	return Workspace.CurrentCamera
end

local function screenScale()
	local view = camera().ViewportSize
	return math.clamp(math.min(view.X / 720, view.Y / 600), 0.55, 1)
end

local function rootPart()
	local character = player.Character
	return character and character:FindFirstChild("HumanoidRootPart")
end

--------------------------------------------------------------------------------
-- Device-specific text
--------------------------------------------------------------------------------

local function device()
	local last = UserInputService:GetLastInputType()
	if last == Enum.UserInputType.Touch then
		return "Touch"
	elseif last.Name:sub(1, 7) == "Gamepad" then
		return "Gamepad"
	elseif last == Enum.UserInputType.Keyboard or last.Name:sub(1, 5) == "Mouse" then
		return "Keyboard"
	end
	return (UserInputService.TouchEnabled and not UserInputService.KeyboardEnabled) and "Touch" or "Keyboard"
end

local function isPerDevice(value)
	return typeof(value) == "table" and (value.Keyboard ~= nil or value.Touch ~= nil or value.Gamepad ~= nil)
end

-- Text falls back to the keyboard version; key hints don't (no "W A S D" on a phone).
local function pick(value, fallback)
	if isPerDevice(value) then
		local own = value[device()]
		if own == nil and fallback then
			return value.Keyboard
		end
		return own
	end
	return value
end

local function islandList()
	local islands = table.clone(Config.Islands)
	table.sort(islands, function(a, b)
		return (a.Level or 1) < (b.Level or 1)
	end)
	local lines = {}
	for _, island in islands do
		table.insert(lines, string.format("   •  <b>%s</b>  –  level %d", island.Name, island.Level or 1))
	end
	return table.concat(lines, "\n")
end

local function fill(text)
	text = tostring(text or "")
	text = text:gsub("{Tool}", function()
		return Config.ToolName
	end)
	text = text:gsub("{Islands}", islandList)
	return text
end

--------------------------------------------------------------------------------
-- Finding things the steps point at
--------------------------------------------------------------------------------

local function ours(inst)
	return inst:IsDescendantOf(gui) or inst:FindFirstAncestor("GuideMarker") ~= nil or inst:FindFirstAncestor("LevelAlerts") ~= nil
end

-- True when a GUI element is actually showing on screen.
local function onScreen(element)
	local node = element
	while node and node ~= playerGui do
		if node:IsA("GuiObject") and not node.Visible then
			return false
		elseif node:IsA("LayerCollector") and not node.Enabled then
			return false
		end
		node = node.Parent
	end
	if node ~= playerGui then
		return false
	end
	local size = element.AbsoluteSize
	return size.X > 4 and size.Y > 4
end

local function hasWord(element, words)
	local name = element.Name:lower()
	local text = (element:IsA("TextButton") or element:IsA("TextLabel")) and element.Text:lower() or ""
	for _, word in words do
		word = word:lower()
		if name:find(word, 1, true) or text:find(word, 1, true) then
			return true
		end
	end
	return false
end

-- The smallest visible button whose name or text has one of the words.
local function findButton(words)
	local best, bestArea = nil, math.huge
	for _, element in playerGui:GetDescendants() do
		if element:IsA("GuiButton") and element:FindFirstAncestorWhichIsA("ScreenGui") and not ours(element) and onScreen(element) then
			local matched = hasWord(element, words)
			if not matched then
				local label = element:FindFirstChildWhichIsA("TextLabel")
				matched = label ~= nil and hasWord(label, words)
			end
			local size = element.AbsoluteSize
			if matched and size.X * size.Y < bestArea then
				best, bestArea = element, size.X * size.Y
			end
		end
	end
	return best
end

-- Open windows (big visible panels, not buttons) whose name, or whose
-- ScreenGui's name, has one of the words.
local function findWindows(words)
	local function window(element)
		if not element:IsA("GuiObject") or element:IsA("GuiButton") then
			return false
		end
		local size = element.AbsoluteSize
		if size.X < 160 or size.Y < 120 then
			return false
		end
		local panel = element.BackgroundTransparency < 0.95
			or ((element:IsA("ImageLabel") or element:IsA("ImageButton")) and element.Image ~= "" and element.ImageTransparency < 0.95)
		return panel and onScreen(element)
	end
	local found = {}
	for _, layer in playerGui:GetChildren() do
		if layer:IsA("ScreenGui") and layer.Enabled and not ours(layer) then
			local layerMatches = hasWord(layer, words)
			for _, element in layer:GetDescendants() do
				if (layerMatches or hasWord(element, words)) and window(element) then
					found[element] = true
				end
			end
		end
	end
	return found
end

-- Screen rectangle of a GUI element in this overlay's coordinates.
local function guiRect(element)
	local position = element.AbsolutePosition
	local layer = element:FindFirstAncestorWhichIsA("ScreenGui")
	if layer and not layer.IgnoreGuiInset then
		position += GuiService:GetGuiInset()
	end
	return position, element.AbsoluteSize
end

local function resolvePath(path)
	local node = Workspace
	for _, name in path do
		node = node:FindFirstChild(name)
		if not node then
			return nil
		end
	end
	return node
end

local function partOf(inst)
	if inst:IsA("BasePart") then
		return inst
	elseif inst:IsA("Model") then
		return inst.PrimaryPart or inst:FindFirstChild("HumanoidRootPart") or inst:FindFirstChildWhichIsA("BasePart", true)
	end
	return inst:FindFirstChildWhichIsA("BasePart", true)
end

local function alive(inst)
	local humanoid = inst:IsA("Model") and inst:FindFirstChildOfClass("Humanoid")
	return not humanoid or humanoid.Health > 0
end

-- The nearest part for a { Tag = ... } or { Path = ... } spec.
local function findWorld(spec)
	local candidates = {}
	if spec.Tag then
		candidates = CollectionService:GetTagged(spec.Tag)
	elseif spec.Path then
		local node = resolvePath(spec.Path)
		if node then
			candidates = (node:IsA("Folder") or (node:IsA("Model") and not node:FindFirstChildOfClass("Humanoid"))) and node:GetChildren() or { node }
		end
	end
	local root = rootPart()
	local best, bestDistance = nil, math.huge
	for _, inst in candidates do
		if inst:IsDescendantOf(Workspace) and alive(inst) then
			local part = partOf(inst)
			if part then
				local distance = root and (part.Position - root.Position).Magnitude or 0
				if distance < bestDistance then
					best, bestDistance = part, distance
				end
			end
		end
	end
	return best
end

local function hasTool(name)
	for _, container in { player.Character, player:FindFirstChildOfClass("Backpack") } do
		if container then
			for _, tool in container:GetChildren() do
				if tool:IsA("Tool") and (not name or tool.Name == name) then
					return true
				end
			end
		end
	end
	return false
end

-- Steps with OnlyIf are left out when the thing they explain isn't in this game.
local function available(step)
	local only = step.OnlyIf
	if not only then
		return true
	elseif only.Tool then
		return hasTool(only.Tool)
	elseif only.Tag then
		return #CollectionService:GetTagged(only.Tag) > 0
	elseif only.Gui then
		return findButton(only.Gui) ~= nil or next(findWindows(only.Gui)) ~= nil
	elseif only.Path then
		return resolvePath(only.Path) ~= nil
	end
	return true
end

--------------------------------------------------------------------------------
-- Overlay pieces: dimmed screen, gold ring, arrows
--------------------------------------------------------------------------------

local dims = {}
for i = 1, 4 do
	dims[i] = make("Frame", {
		BackgroundColor3 = Color3.new(0, 0, 0),
		BackgroundTransparency = 0.45,
		BorderSizePixel = 0,
		Visible = false,
		ZIndex = 1,
	}, gui)
end

local ring = make("Frame", { BackgroundTransparency = 1, Visible = false, ZIndex = 2 }, gui)
local ringStroke = make("UIStroke", { Color = C.Gold, Thickness = 3 }, ring)
Style.corner(ring, UDim.new(0, 10))

local function rotate(v, degrees)
	local r = math.rad(degrees)
	local cos, sin = math.cos(r), math.sin(r)
	return Vector2.new(v.X * cos - v.Y * sin, v.X * sin + v.Y * cos)
end

-- A double chevron ">>" made of four bars, so it can point any way.
local function newChevron(parent, z)
	local bars = {}
	for i = 1, 4 do
		bars[i] = make("Frame", {
			AnchorPoint = Vector2.new(0.5, 0.5),
			Size = UDim2.fromOffset(24, 8),
			BackgroundColor3 = C.Gold,
			BackgroundTransparency = i > 2 and 0.4 or 0,
			BorderSizePixel = 0,
			Visible = false,
			ZIndex = z,
		}, parent)
		Style.corner(bars[i], UDim.new(0.5, 0))
		make("UIStroke", { Color = C.Outline, Thickness = 1.5, Transparency = 0.35 }, bars[i])
	end
	return bars
end

-- angle: 0 points right, 90 points down.
local function placeChevron(bars, tip, angle)
	local a = math.rad(angle)
	local dir = Vector2.new(math.cos(a), math.sin(a))
	for k = 0, 1 do
		local point = tip - dir * (k * 14)
		for s = 0, 1 do
			local back = rotate(-dir, s == 0 and 45 or -45)
			local center = point + back * 9
			local bar = bars[k * 2 + s + 1]
			bar.Position = UDim2.fromOffset(center.X, center.Y)
			bar.Rotation = math.deg(math.atan2(back.Y, back.X))
			bar.Visible = true
		end
	end
end

local function hideChevron(bars)
	for _, bar in bars do
		bar.Visible = false
	end
end

local guiArrow = newChevron(gui, 3)
local edgeArrow = newChevron(gui, 3)
local edgeLabel = Style.label({
	AnchorPoint = Vector2.new(0.5, 0.5),
	Size = UDim2.fromOffset(160, 40),
	FontFace = Style.FontTitle,
	TextSize = 15,
	TextStrokeTransparency = 0.2,
	Visible = false,
	ZIndex = 3,
}, gui)

--------------------------------------------------------------------------------
-- The card
--------------------------------------------------------------------------------

local card = make("CanvasGroup", {
	Name = "Card",
	Size = UDim2.fromOffset(CARD_WIDTH, 0),
	AutomaticSize = Enum.AutomaticSize.Y,
	BorderSizePixel = 0,
	Visible = false,
	ZIndex = 10,
}, gui)
Style.gradient(card, C.WindowTop, C.WindowBottom)
Style.corner(card, UDim.new(0, 10))
local cardScale = make("UIScale", {}, card)
make("UIListLayout", { SortOrder = Enum.SortOrder.LayoutOrder }, card)

-- The card's border is a frame behind it, since a CanvasGroup would clip a stroke.
local cardBorder = make("Frame", {
	BackgroundTransparency = 1,
	Visible = false,
	ZIndex = 9,
}, gui)
make("UIStroke", { Color = C.WindowBorder, Thickness = 3 }, cardBorder)
Style.corner(cardBorder, UDim.new(0, 10))

local header = make("Frame", { Size = UDim2.new(1, 0, 0, 42), BorderSizePixel = 0, LayoutOrder = 1 }, card)
Style.gradient(header, C.HeaderTop, C.HeaderBottom)
Style.label({
	Text = "📘  TUTORIAL",
	FontFace = Style.FontTitle,
	TextSize = 17,
	TextStrokeTransparency = 0.4,
	TextXAlignment = Enum.TextXAlignment.Left,
	Position = UDim2.fromOffset(16, 0),
	Size = UDim2.new(0.5, 0, 1, 0),
}, header)
local stepLabel = Style.label({
	FontFace = Style.FontBold,
	TextSize = 14,
	TextColor3 = Color3.fromRGB(255, 214, 214),
	TextXAlignment = Enum.TextXAlignment.Right,
	AnchorPoint = Vector2.new(1, 0),
	Position = UDim2.new(1, -52, 0, 0),
	Size = UDim2.new(0.5, -60, 1, 0),
}, header)
local closeButton = make("TextButton", {
	Text = "X",
	FontFace = Style.FontTitle,
	TextSize = 22,
	TextColor3 = C.Text,
	TextStrokeTransparency = 0.3,
	BackgroundTransparency = 1,
	AnchorPoint = Vector2.new(1, 0.5),
	Position = UDim2.new(1, -6, 0.5, 0),
	Size = UDim2.fromOffset(40, 40),
}, header)

local helpButton = make("TextButton", {
	Name = "TutorialHelp",
	Text = "?",
	FontFace = Style.FontTitle,
	TextSize = 28,
	TextColor3 = C.DarkText,
	AnchorPoint = Vector2.new(0, 0.5),
	Position = settings.HelpButtonPosition or UDim2.new(0, 14, 0.5, 0),
