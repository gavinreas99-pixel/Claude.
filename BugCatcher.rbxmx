<roblox xmlns:xmime="http://www.w3.org/2005/05/xmlmime" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://www.roblox.com/roblox.xsd" version="4">
	<Item class="Folder" referent="RBX0">
		<Properties><string name="Name">BugCatcher</string></Properties>
		<Item class="ModuleScript" referent="RBX1">
			<Properties>
				<string name="Name">Config</string>
				<ProtectedString name="Source"><![CDATA[--[[
	Bug Catcher settings. Change these numbers to tune the game.
]]

return {
	-- Field ------------------------------------------------------------------
	FieldRadius = 150, -- radius of the open meadow, in studs
	Seed = 7, -- change this for a different layout of trees and flowers
	TreeCount = 30,
	BushCount = 22,
	RockCount = 12,
	FlowerPatches = 55,
	GrassTufts = 260,
	RemoveBaseplate = true, -- delete the template "Baseplate" so it doesn't cover the grass

	-- Day and night ----------------------------------------------------------
	DayMinutes = 6, -- real minutes from sunrise to sunset
	NightMinutes = 4, -- real minutes from sunset to sunrise
	StartClockTime = 8.5, -- time of day when the server starts (24-hour clock)

	-- Rain -------------------------------------------------------------------
	RainCheckSeconds = 40, -- how often the sky "rolls the dice" for rain
	RainChance = 0.3, -- chance that it starts raining on each roll
	RainSeconds = { 50, 100 }, -- a shower lasts between these many seconds

	-- Bugs -------------------------------------------------------------------
	MaxCommonBugs = 14,
	MaxRareBugs = 5, -- only at night
	MaxEpicBugs = 4, -- only while it rains
	SpawnInterval = 1.5, -- seconds between spawn attempts
	SpawnMinPlayerDistance = 20, -- bugs never pop in right next to a player

	-- Bug net ----------------------------------------------------------------
	NetName = "Bug Net",
	SwingCooldown = 0.55, -- seconds between swings
	NetReach = 3.5, -- how far in front of the player the net lands
	NetRadius = 5, -- bugs this close (sideways) to that spot get caught
	NetHeight = 5.5, -- ...and this close vertically

	-- Saving -----------------------------------------------------------------
	DataStoreName = "BugCatcher_v1",
	AutosaveSeconds = 90,

	-- Sounds -----------------------------------------------------------------
	-- Built-in Roblox sounds (rbxasset://) always work. The rain loop is a free
	-- Roblox library sound. Paste any other ID from the Creator Store to swap one,
	-- like Rain = "rbxassetid://123456". Leave "" for silence.
	Sounds = {
		Footsteps = "rbxasset://sounds/action_footsteps_plastic.mp3",
		Rain = "rbxassetid://9112854440",
		Swing = "rbxasset://sounds/swordslash.wav",
		Catch = "rbxasset://sounds/electronicpingshort.wav",
		NewBug = "rbxasset://sounds/victory.wav", -- extra fanfare for a bug you've never caught
	},
	FootstepVolume = 0.45,
	RainVolume = 0.7,
}
]]></ProtectedString>
			</Properties>
		</Item>
		<Item class="ModuleScript" referent="RBX2">
			<Properties>
				<string name="Name">Util</string>
				<ProtectedString name="Source"><![CDATA[--[[
	Small helpers shared by the server and client scripts.
]]

local Util = {}

-- Makes an Instance and sets its properties in one go:
--   create("Part", { Name = "Rock", Size = Vector3.one, Parent = workspace })
-- Parent is always set last so the instance is fully set up before it replicates.
function Util.create(className, props)
	local instance = Instance.new(className)
	local parent = nil
	for key, value in props or {} do
		if key == "Parent" then
			parent = value
		else
			instance[key] = value
		end
	end
	if parent then
		instance.Parent = parent
	end
	return instance
end

-- An anchored part that never collides or blocks raycasts: for decoration.
function Util.decor(props)
	local part = Util.create("Part", {
		Anchored = true,
		CanCollide = false,
		CanQuery = false,
		CanTouch = false,
		TopSurface = Enum.SurfaceType.Smooth,
		BottomSurface = Enum.SurfaceType.Smooth,
	})
	for key, value in props do
		if key ~= "Parent" then
			part[key] = value
		end
	end
	part.Parent = props.Parent
	return part
end

-- Turns a part into an ellipsoid that fills its Size.
function Util.ellipsoid(part)
	Util.create("SpecialMesh", { MeshType = Enum.MeshType.Sphere, Parent = part })
	return part
end

-- A CFrame at `position` whose cylinder axis (a Part's X axis) points straight up.
function Util.upright(position)
	return CFrame.new(position) * CFrame.Angles(0, 0, math.pi / 2)
end

-- Frame-rate independent smoothing factor: lerp(a, b, Util.smooth(speed, dt)).
function Util.smooth(speed, dt)
	return 1 - math.exp(-speed * dt)
end

function Util.lerp(a, b, t)
	return a + (b - a) * t
end

-- Plays a one-shot sound at a part (or non-positional when parent is SoundService).
function Util.playSound(soundId, parent, volume, pitch)
	if not soundId or soundId == "" then
		return
	end
	local sound = Util.create("Sound", {
		SoundId = soundId,
		Volume = volume or 0.6,
		PlaybackSpeed = pitch or 1,
		RollOffMaxDistance = 80,
		Parent = parent,
	})
	sound:Play()
	sound.Ended:Once(function()
		sound:Destroy()
	end)
	task.delay(8, function()
		if sound.Parent then
			sound:Destroy()
		end
	end)
end

return Util
]]></ProtectedString>
			</Properties>
		</Item>
		<Item class="ModuleScript" referent="RBX3">
			<Properties>
				<string name="Name">Environment</string>
				<ProtectedString name="Source"><![CDATA[--[[
	Environment: the shared clock and weather.

	The server stores one number, the server time of a sunrise
	(attribute "SunriseTime" on the BugCatcher folder), and whether it's
	raining (attribute "Raining"). Everyone works out the time of day from
	that, so the sun moves smoothly on every screen without any network
	traffic, and the server and clients always agree on day and night.
]]

local Workspace = game:GetService("Workspace")

local folder = script.Parent
local Config = require(folder:WaitForChild("Config"))

local DAY = Config.DayMinutes * 60
local NIGHT = Config.NightMinutes * 60
local CYCLE = DAY + NIGHT

local Environment = {}

-- How many real seconds after sunrise (6:00) a given clock time is.
function Environment.secondsAfterSunrise(clockTime)
	local hours = (clockTime - 6) % 24
	if hours < 12 then
		return hours / 12 * DAY
	end
	return DAY + (hours - 12) / 12 * NIGHT
end

-- The clock time (0-24) a number of real seconds after a sunrise.
function Environment.clockAt(seconds)
	local t = seconds % CYCLE
	if t < DAY then
		return 6 + 12 * t / DAY
	end
	return (18 + 12 * (t - DAY) / NIGHT) % 24
end

function Environment.getClockTime()
	local sunrise = folder:GetAttribute("SunriseTime")
	if type(sunrise) ~= "number" then
		return Config.StartClockTime
	end
	return Environment.clockAt(Workspace:GetServerTimeNow() - sunrise)
end

function Environment.isNight(clockTime)
	local clock = clockTime or Environment.getClockTime()
	return clock < 6 or clock >= 18
end

function Environment.isRaining()
	return folder:GetAttribute("Raining") == true
end

return Environment
]]></ProtectedString>
			</Properties>
		</Item>
		<Item class="ModuleScript" referent="RBX4">
			<Properties>
				<string name="Name">BugData</string>
				<ProtectedString name="Source"><![CDATA[--[[
	BugData: every bug in the game, in collection-book order.

	Fields:
	  Id       unique key, also used in saved data (don't rename once players have it)
	  Name     shown in the book and popups
	  Rarity   "Common" (any time), "Rare" (night only) or "Epic" (rain only)
	  Shape    body plan BugBuilder draws: Beetle, Bee, Butterfly, Dragonfly, Hopper, Ant, Worm
	  Move     "Fly" or "Crawl"
	  Scale    size multiplier
	  Speed    wandering speed in studs per second
	  Colors   colours for BugBuilder (Body, Accent, Wing, Glow, ...)
]]

local function rgb(r, g, b)
	return Color3.fromRGB(r, g, b)
end

local BugData = {}

BugData.Rarities = {
	Common = {
		Order = 1,
		Color = rgb(112, 190, 96),
		Hint = "Any time",
		Glow = false,
		FleeRadius = 11, -- studs: how close a player can get before the bug runs
		FleeSpeed = 9.5,
	},
	Rare = {
		Order = 2,
		Color = rgb(112, 156, 255),
		Hint = "Only at night",
		Glow = true,
		FleeRadius = 13,
		FleeSpeed = 11.5,
	},
	Epic = {
		Order = 3,
		Color = rgb(255, 168, 40),
		Hint = "Only in the rain",
		Glow = true,
		FleeRadius = 14,
		FleeSpeed = 12.5,
	},
}

BugData.List = {
	{
		Id = "Ladybug",
		Name = "Ladybug",
		Rarity = "Common",
		Shape = "Beetle",
		Move = "Crawl",
		Scale = 1,
		Speed = 3.5,
		Spots = true,
		Colors = { Body = rgb(30, 28, 30), Shell = rgb(222, 38, 32), Accent = rgb(20, 20, 20) },
	},
	{
		Id = "Honeybee",
		Name = "Honeybee",
		Rarity = "Common",
		Shape = "Bee",
		Move = "Fly",
		Scale = 1,
		Speed = 7,
		Colors = { Body = rgb(246, 186, 36), Accent = rgb(40, 30, 22), Fuzz = rgb(196, 140, 44), Wing = rgb(228, 240, 255) },
	},
	{
		Id = "CabbageWhite",
		Name = "Cabbage White",
		Rarity = "Common",
		Shape = "Butterfly",
		Move = "Fly",
		Scale = 1.15,
		Speed = 5,
		Colors = { Body = rgb(70, 70, 72), Wing = rgb(250, 250, 242), Accent = rgb(52, 52, 56) },
	},
	{
		Id = "Grasshopper",
		Name = "Grasshopper",
		Rarity = "Common",
		Shape = "Hopper",
		Move = "Crawl",
		Scale = 1.2,
		Speed = 5,
		Colors = { Body = rgb(112, 172, 58), Accent = rgb(78, 128, 40) },
	},
	{
		Id = "BlueDragonfly",
		Name = "Blue Dragonfly",
		Rarity = "Common",
		Shape = "Dragonfly",
		Move = "Fly",
		Scale = 1.3,
		Speed = 9,
		Colors = { Body = rgb(40, 118, 222), Accent = rgb(24, 60, 120), Wing = rgb(220, 236, 255) },
	},
	{
		Id = "BlackAnt",
		Name = "Black Ant",
		Rarity = "Common",
		Shape = "Ant",
		Move = "Crawl",
		Scale = 1,
		Speed = 4.5,
		Colors = { Body = rgb(36, 30, 30), Accent = rgb(70, 50, 44) },
	},
	{
		Id = "Firefly",
		Name = "Firefly",
		Rarity = "Rare",
		Shape = "Bee",
		Move = "Fly",
		Scale = 1,
		Speed = 4,
		Colors = { Body = rgb(62, 52, 40), Accent = rgb(196, 64, 40), Fuzz = rgb(70, 58, 46), Wing = rgb(150, 132, 100), Glow = rgb(214, 255, 80) },
	},
	{
		Id = "LunaMoth",
		Name = "Luna Moth",
		Rarity = "Rare",
		Shape = "Butterfly",
		Move = "Fly",
		Scale = 1.45,
		Speed = 4,
		Tails = true,
		Colors = { Body = rgb(240, 240, 220), Wing = rgb(186, 240, 168), Accent = rgb(236, 196, 112), Glow = rgb(160, 255, 200) },
	},
	{
		Id = "Glowworm",
		Name = "Glowworm",
		Rarity = "Rare",
		Shape = "Worm",
		Move = "Crawl",
		Scale = 1.2,
		Speed = 2.5,
		Colors = { Body = rgb(58, 84, 88), Glow = rgb(80, 236, 255) },
	},
	{
		Id = "RainbowScarab",
		Name = "Rainbow Scarab",
		Rarity = "Epic",
		Shape = "Beetle",
		Move = "Crawl",
		Scale = 1.3,
		Speed = 4,
		Rainbow = true,
		Colors = { Body = rgb(40, 30, 60), Shell = rgb(170, 70, 255), Accent = rgb(60, 220, 200), Glow = rgb(220, 120, 255) },
	},
	{
		Id = "StormDragonfly",
		Name = "Storm Dragonfly",
		Rarity = "Epic",
		Shape = "Dragonfly",
		Move = "Fly",
		Scale = 1.5,
		Speed = 10,
		Colors = { Body = rgb(96, 70, 226), Accent = rgb(150, 220, 255), Wing = rgb(190, 214, 255), Glow = rgb(130, 196, 255) },
	},
	{
		Id = "CrystalButterfly",
		Name = "Crystal Butterfly",
		Rarity = "Epic",
		Shape = "Butterfly",
		Move = "Fly",
		Scale = 1.55,
		Speed = 5,
		Crystal = true,
		Colors = { Body = rgb(150, 220, 240), Wing = rgb(170, 238, 255), Accent = rgb(255, 255, 255), Glow = rgb(196, 248, 255) },
	},
}

BugData.ById = {}
BugData.ByRarity = { Common = {}, Rare = {}, Epic = {} }
for index, bug in BugData.List do
	bug.Order = index
	BugData.ById[bug.Id] = bug
	table.insert(BugData.ByRarity[bug.Rarity], bug)
end

return BugData
]]></ProtectedString>
			</Properties>
		</Item>
		<Item class="ModuleScript" referent="RBX5">
			<Properties>
				<string name="Name">BugBuilder</string>
				<ProtectedString name="Source"><![CDATA[--[[
	BugBuilder

	Draws a bug out of small rounded parts. Each bug faces -Z with its body
	centre at the origin. Moving parts (wings, legs, antennae, worm segments)
	are recorded with the hinge they turn around, so BugVisuals can flap and
	scuttle them every frame without any joints or physics.

	Usage:
		local rig = BugBuilder.build(BugData.ById.Ladybug, { effects = true })
		rig.model.Parent = workspace
		-- rig.parts: { part, rel, kind, side, hinge, phase, index }
		-- rig.glow / rig.rainbow: parts to pulse or recolour, rig.light: PointLight or nil

	BugBuilder.groundOffset(bug) is how high a crawling bug's centre sits
	above the ground; the server uses it too, so it builds nothing on require.
]]

local Util = require(script.Parent:WaitForChild("Util"))
local BugData = require(script.Parent:WaitForChild("BugData"))
local create, ellipsoid = Util.create, Util.ellipsoid

local BugBuilder = {}

local SIZE = 1.3 -- a Scale 1 bug's body is about 1.3 studs long

local SHAPE_HEIGHT = {
	Beetle = 0.38,
	Bee = 0.38,
	Butterfly = 0.1,
	Dragonfly = 0.12,
	Hopper = 0.36,
	Ant = 0.3,
	Worm = 0.16,
}

local DARK = Color3.fromRGB(22, 20, 24)
local WHITE = Color3.fromRGB(245, 245, 240)

local V = Vector3.new

function BugBuilder.scale(bug)
	return SIZE * bug.Scale
end

function BugBuilder.groundOffset(bug)
	return (SHAPE_HEIGHT[bug.Shape] or 0.3) * BugBuilder.scale(bug)
end

local function scaled(cf, s)
	return CFrame.new(cf.Position * s) * cf.Rotation
end

-- A CFrame at `from` whose X axis (a cylinder's length) points at `to`.
local function along(from, to)
	local direction = to - from
	local up = math.abs(direction.Unit.Y) > 0.98 and Vector3.xAxis or Vector3.yAxis
	return CFrame.lookAt((from + to) / 2, to, up) * CFrame.Angles(0, math.pi / 2, 0)
end

local function add(rig, spec)
	local s = rig.scale
	local cf = scaled(spec.cf, s)
	local transparency = spec.transparency or 0
	local part = create("Part", {
		Name = spec.name or "Part",
		Anchored = true,
		CanCollide = false,
		CanQuery = false,
		CanTouch = false,
		Massless = true,
		CastShadow = transparency < 0.3,
		TopSurface = Enum.SurfaceType.Smooth,
		BottomSurface = Enum.SurfaceType.Smooth,
		Size = spec.size * s,
		CFrame = cf,
		Color = spec.color,
		Material = spec.material or Enum.Material.SmoothPlastic,
		Transparency = transparency,
		Reflectance = spec.reflectance or 0,
	})
	if spec.shape == "cyl" then
		part.Shape = Enum.PartType.Cylinder
	elseif spec.shape ~= "block" then
		ellipsoid(part)
	end
	part.Parent = rig.model
	if not rig.model.PrimaryPart then
		rig.model.PrimaryPart = part
	end

	local hinge = spec.hinge and scaled(spec.hinge, s)
	table.insert(rig.parts, {
		part = part,
		rel = hinge and hinge:Inverse() * cf or cf,
		kind = spec.kind,
		side = spec.side or 1,
		hinge = hinge,
		phase = spec.phase or 0,
		index = spec.index or 0,
	})
	if spec.glow then
		table.insert(rig.glow, part)
	end
	if spec.rainbow then
		table.insert(rig.rainbow, part)
	end
	return part
end

-- A thin cylinder from one point to another (legs, antennae).
local function limb(rig, from, to, thickness, color, kind, side, phase)
	return add(rig, {
		name = kind == "antenna" and "Antenna" or "Leg",
		shape = "cyl",
		size = V((to - from).Magnitude, thickness, thickness),
		cf = along(from, to),
		color = color,
		kind = kind,
		side = side,
		hinge = CFrame.new(from),
		phase = phase,
	})
end

local function antennae(rig, from, to, color, club)
	for _, side in { -1, 1 } do
		local a = V(from.X * side, from.Y, from.Z)
		local b = V(to.X * side, to.Y, to.Z)
		limb(rig, a, b, 0.03, color, "antenna", side, side)
		if club then
			add(rig, { name = "Club", size = V(0.07, 0.07, 0.1), cf = CFrame.new(b), color = color, kind = "antenna", side = side, hinge = CFrame.new(a), phase = side })
		end
	end
end

-- Six legs in two rows. `rows` = { { z, reachZ }, ... } front to back.
local function sixLegs(rig, hipX, hipY, footX, footY, rows, thickness, color)
	for i, row in rows do
		for _, side in { -1, 1 } do
			local hip = V(hipX * side, hipY, row[1])
			local foot = V(footX * side, footY, row[1] + row[2])
			-- Tripod gait: front and back legs on one side move with the middle leg on the other.
			local phase = ((i + (side > 0 and 1 or 0)) % 2) * math.pi
			limb(rig, hip, foot, thickness, color, "leg", side, phase)
		end
	end
end

local function wing(rig, spec, side)
	spec.name = spec.name or "Wing"
	spec.kind = "wing"
	spec.side = side
	return add(rig, spec)
end

local BUILDERS = {}

function BUILDERS.Beetle(rig, bug)
	local c = bug.Colors
	add(rig, { name = "Body", size = V(0.7, 0.3, 0.85), cf = CFrame.new(0, -0.08, 0.04), color = c.Body })
	add(rig, {
		name = "Shell",
		size = V(0.82, 0.5, 0.95),
		cf = CFrame.new(0, 0.05, 0.06),
		color = c.Shell,
		reflectance = bug.Rainbow and 0.25 or 0.05,
		rainbow = bug.Rainbow,
	})
	add(rig, { name = "Seam", shape = "block", size = V(0.025, 0.03, 0.6), cf = CFrame.new(0, 0.29, 0.12), color = c.Accent })
	add(rig, { name = "Head", size = V(0.42, 0.3, 0.3), cf = CFrame.new(0, -0.02, -0.46), color = c.Body })

	if bug.Spots then
		-- Spots sit on the shell surface, tilted to follow its curve.
		local a, b, cz = 0.41, 0.25, 0.475
		for _, spot in { { 0.2, -0.12 }, { 0.27, 0.18 }, { 0.12, 0.42 } } do
			for _, side in { -1, 1 } do
				local x, z = spot[1] * side, spot[2]
				local u = (x / a) ^ 2 + ((z - 0.06) / cz) ^ 2
				local y = 0.05 + b * math.sqrt(math.max(0, 1 - u))
				local position = V(x, y - 0.01, z)
				local normal = V(x / a ^ 2, (y - 0.05) / b ^ 2, (z - 0.06) / cz ^ 2).Unit
				add(rig, {
					name = "Spot",
					size = V(0.17, 0.06, 0.17),
					cf = CFrame.lookAt(position, position + normal) * CFrame.Angles(-math.pi / 2, 0, 0),
					color = c.Accent,
				})
			end
		end
		for _, side in { -1, 1 } do
			add(rig, { name = "Cheek", size = V(0.1, 0.06, 0.08), cf = CFrame.new(0.12 * side, 0.08, -0.53), color = WHITE })
		end
	end

	antennae(rig, V(0.08, 0.05, -0.58), V(0.18, 0.18, -0.78), c.Body, false)
	sixLegs(rig, 0.28, -0.12, 0.48, -0.38, { { -0.22, -0.1 }, { 0.04, 0 }, { 0.3, 0.1 } }, 0.045, c.Body)
end

function BUILDERS.Bee(rig, bug)
	local c = bug.Colors
	local firefly = c.Glow ~= nil
	add(rig, { name = "Body", size = V(0.42, 0.4, 0.42), cf = CFrame.new(0, 0.02, -0.08), color = c.Fuzz, material = Enum.Material.Fabric })
	add(rig, { name = "Abdomen", size = V(0.44, 0.42, 0.68), cf = CFrame.new(0, -0.02, 0.36), color = c.Body })
	if firefly then
		add(rig, { name = "Lantern", size = V(0.36, 0.34, 0.3), cf = CFrame.new(0, -0.04, 0.6), color = c.Glow, material = Enum.Material.Neon, glow = true })
	else
		-- Stripes: thin rings just proud of the abdomen's surface.
		for _, z in { 0.3, 0.46, 0.6 } do
			local k = math.sqrt(1 - ((z - 0.36) / 0.34) ^ 2)
			add(rig, { name = "Stripe", size = V(0.44 * k + 0.025, 0.42 * k + 0.025, 0.08), cf = CFrame.new(0, -0.02, z), color = c.Accent })
		end
	end
	add(rig, { name = "Head", size = V(0.32, 0.3, 0.26), cf = CFrame.new(0, 0.03, -0.38), color = c.Accent })
	for _, side in { -1, 1 } do
		add(rig, { name = "Eye", size = V(0.13, 0.15, 0.12), cf = CFrame.new(0.12 * side, 0.06, -0.44), color = DARK, reflectance = 0.2 })
	end
	antennae(rig, V(0.06, 0.15, -0.46), V(0.14, 0.32, -0.62), DARK, false)
	for _, side in { -1, 1 } do
		local transparency = firefly and 0.15 or 0.45
		wing(rig, {
			size = V(0.62, 0.02, 0.26),
			cf = CFrame.new(0.34 * side, 0.24, 0.02) * CFrame.Angles(0, -0.35 * side, 0),
			color = c.Wing,
			transparency = transparency,
			hinge = CFrame.new(0.05 * side, 0.22, -0.06),
		}, side)
		wing(rig, {
			size = V(0.42, 0.02, 0.2),
			cf = CFrame.new(0.26 * side, 0.22, 0.16) * CFrame.Angles(0, -0.6 * side, 0),
			color = c.Wing,
			transparency = transparency,
			hinge = CFrame.new(0.05 * side, 0.22, -0.06),
		}, side)
	end
	sixLegs(rig, 0.14, -0.15, 0.24, -0.38, { { -0.14, 0.05 }, { -0.02, 0.05 }, { 0.1, 0.05 } }, 0.035, DARK)
end

function BUILDERS.Butterfly(rig, bug)
	local c = bug.Colors
	local wingMaterial = bug.Crystal and Enum.Material.Glass or Enum.Material.SmoothPlastic
	local wingTransparency = bug.Crystal and 0.3 or 0
	add(rig, { name = "Body", size = V(0.13, 0.13, 0.72), cf = CFrame.new(0, 0, 0.04), color = c.Body, material = Enum.Material.Fabric })
	add(rig, { name = "Head", size = V(0.17, 0.16, 0.16), cf = CFrame.new(0, 0.02, -0.36), color = c.Body })
	antennae(rig, V(0.04, 0.06, -0.42), V(0.16, 0.26, -0.72), c.Body, true)

	for _, side in { -1, 1 } do
		local foreHinge = CFrame.new(0.05 * side, 0.03, -0.05)
		local hindHinge = CFrame.new(0.05 * side, 0.01, 0.08)
		local fore = CFrame.new(0.42 * side, 0.03, -0.1) * CFrame.Angles(0, 0.3 * side, 0)
		local hind = CFrame.new(0.32 * side, 0.01, 0.2) * CFrame.Angles(0, -0.45 * side, 0)
		wing(rig, { size = V(0.78, 0.025, 0.56), cf = fore, color = c.Wing, material = wingMaterial, transparency = wingTransparency, hinge = foreHinge, glow = bug.Crystal }, side)
		wing(rig, { size = V(0.58, 0.025, 0.48), cf = hind, color = c.Wing, material = wingMaterial, transparency = wingTransparency, hinge = hindHinge, glow = bug.Crystal }, side)

		if bug.Tails then
			-- Luna moth: eyespots and long trailing tails.
			wing(rig, { name = "Eyespot", size = V(0.13, 0.03, 0.13), cf = hind * CFrame.new(0.02 * side, 0.004, 0), color = c.Accent, hinge = hindHinge }, side)
			wing(rig, { name = "Tail", size = V(0.1, 0.025, 0.62), cf = hind * CFrame.new(0.06 * side, 0, 0.42), color = c.Wing, hinge = hindHinge }, side)
		elseif bug.Crystal then
			wing(rig, { name = "Shine", size = V(0.3, 0.03, 0.2), cf = fore * CFrame.new(0.12 * side, 0.004, -0.04), color = c.Accent, material = Enum.Material.Neon, transparency = 0.4, hinge = foreHinge, glow = true }, side)
		else
			-- Cabbage white: dark wing tips and a spot.
			wing(rig, { name = "Tip", size = V(0.26, 0.03, 0.2), cf = fore * CFrame.new(0.26 * side, 0.004, -0.09), color = c.Accent, hinge = foreHinge }, side)
			wing(rig, { name = "Dot", size = V(0.1, 0.03, 0.1), cf = fore * CFrame.new(0.06 * side, 0.004, 0.08), color = c.Accent, hinge = foreHinge }, side)
		end
	end
end

function BUILDERS.Dragonfly(rig, bug)
	local c = bug.Colors
	local storm = c.Glow ~= nil
	add(rig, { name = "Body", size = V(0.22, 0.24, 0.36), cf = CFrame.new(0, 0, -0.2), color = c.Body })
	add(rig, { name = "Tail", size = V(0.1, 0.1, 1.25), cf = CFrame.new(0, 0, 0.58), color = c.Body, reflectance = 0.15 })
	for _, z in { 0.25, 0.5, 0.75, 0.98 } do
		local k = math.sqrt(1 - ((z - 0.58) / 0.625) ^ 2)
		add(rig, {
			name = "Ring",
			size = V(0.1 * k + 0.02, 0.1 * k + 0.02, 0.06),
			cf = CFrame.new(0, 0, z),
			color = storm and c.Glow or c.Accent,
			material = storm and Enum.Material.Neon or Enum.Material.SmoothPlastic,
			glow = storm,
		})
	end
	add(rig, { name = "Head", size = V(0.26, 0.22, 0.2), cf = CFrame.new(0, 0.02, -0.44), color = c.Body })
	for _, side in { -1, 1 } do
		add(rig, { name = "Eye", size = V(0.17, 0.17, 0.17), cf = CFrame.new(0.09 * side, 0.05, -0.47), color = c.Accent, reflectance = 0.25 })
		wing(rig, {
			size = V(1, 0.02, 0.17),
			cf = CFrame.new(0.54 * side, 0.13, -0.28) * CFrame.Angles(0, 0.08 * side, 0),
			color = c.Wing,
			transparency = 0.55,
			hinge = CFrame.new(0.06 * side, 0.12, -0.26),
		}, side)
		wing(rig, {
			size = V(0.95, 0.02, 0.2),
			cf = CFrame.new(0.52 * side, 0.13, -0.08) * CFrame.Angles(0, -0.1 * side, 0),
			color = c.Wing,
			transparency = 0.55,
			hinge = CFrame.new(0.06 * side, 0.12, -0.1),
			phase = math.pi / 2,
		}, side)
	end
end

function BUILDERS.Hopper(rig, bug)
	local c = bug.Colors
	add(rig, { name = "Body", size = V(0.3, 0.32, 0.95), cf = CFrame.new(0, 0.04, 0.08), color = c.Body })
	add(rig, { name = "Head", size = V(0.28, 0.36, 0.3), cf = CFrame.new(0, 0.12, -0.46) * CFrame.Angles(0.4, 0, 0), color = c.Body })
	for _, side in { -1, 1 } do
		add(rig, { name = "Eye", size = V(0.1, 0.12, 0.1), cf = CFrame.new(0.12 * side, 0.2, -0.5), color = Color3.fromRGB(60, 44, 30) })
		add(rig, { name = "WingCover", size = V(0.2, 0.05, 0.75), cf = CFrame.new(0.08 * side, 0.18, 0.2), color = c.Accent })
		-- Big jumping legs: thigh up and back to a high knee, shin down to the ground.
		local hip = V(0.17 * side, 0.02, 0.05)
		local knee = V(0.22 * side, 0.3, 0.45)
		local foot = V(0.25 * side, -0.36, 0.36)
		limb(rig, hip, knee, 0.12, c.Body, nil, side)
		limb(rig, knee, foot, 0.05, c.Accent, nil, side)
	end
	antennae(rig, V(0.05, 0.25, -0.56), V(0.16, 0.45, -0.95), c.Accent, false)
	for i, z in { -0.3, -0.1 } do
		for _, side in { -1, 1 } do
			local phase = ((i + (side > 0 and 1 or 0)) % 2) * math.pi
			limb(rig, V(0.14 * side, -0.06, z), V(0.32 * side, -0.36, z - 0.06), 0.045, c.Accent, "leg", side, phase)
		end
	end
end

function BUILDERS.Ant(rig, bug)
	local c = bug.Colors
	add(rig, { name = "Body", size = V(0.18, 0.18, 0.36), cf = CFrame.new(0, 0.02, -0.15), color = c.Body, reflectance = 0.1 })
	add(rig, { name = "Head", size = V(0.3, 0.28, 0.3), cf = CFrame.new(0, 0.05, -0.48), color = c.Body, reflectance = 0.1 })
	add(rig, { name = "Waist", size = V(0.1, 0.1, 0.12), cf = CFrame.new(0, 0, 0.06), color = c.Body })
	add(rig, { name = "Abdomen", size = V(0.38, 0.36, 0.5), cf = CFrame.new(0, 0.06, 0.34), color = c.Body, reflectance = 0.15 })
	for _, side in { -1, 1 } do
		local base = V(0.06 * side, 0.15, -0.56)
		local elbow = V(0.16 * side, 0.3, -0.68)
		limb(rig, base, elbow, 0.03, c.Accent, "antenna", side, side)
		add(rig, {
			name = "Antenna",
			shape = "cyl",
			size = V(0.2, 0.03, 0.03),
			cf = along(elbow, V(0.2 * side, 0.22, -0.86)),
			color = c.Accent,
			kind = "antenna",
			side = side,
			hinge = CFrame.new(base),
			phase = side,
		})
	end
	sixLegs(rig, 0.08, -0.04, 0.42, -0.3, { { -0.24, -0.18 }, { -0.14, 0 }, { -0.04, 0.18 } }, 0.035, c.Accent)
end

function BUILDERS.Worm(rig, bug)
	local c = bug.Colors
	for i = 0, 6 do
		local radius = 0.17 - i * 0.012
		local glowing = i >= 4
		add(rig, {
			name = i == 0 and "Body" or "Segment",
			size = V(radius * 2, radius * 1.8, radius * 2.1),
			cf = CFrame.new(0, 0, -0.45 + i * 0.15),
			color = glowing and c.Glow or c.Body,
			material = glowing and Enum.Material.Neon or Enum.Material.SmoothPlastic,
			kind = "segment",
			index = i,
			glow = glowing,
		})
	end
	for _, side in { -1, 1 } do
		add(rig, { name = "Eye", size = V(0.05, 0.05, 0.05), cf = CFrame.new(0.07 * side, 0.07, -0.58), color = DARK, kind = "segment", index = 0 })
	end
end

-- Glowing bugs get a soft light, a faint halo and drifting sparkles.
local function addGlow(rig, bug)
	local glowColor = bug.Colors.Glow or BugData.Rarities[bug.Rarity].Color
	local body = rig.model.PrimaryPart
	-- Fireflies and glowworms glow from their tails; everything else from the body.
	local tail = rig.glow[1]
	local core = (tail and (tail.Name == "Lantern" or tail.Name == "Segment")) and tail or body
	rig.light = create("PointLight", {
		Color = glowColor,
		Brightness = 2,
		Range = 10,
		Shadows = false,
		Parent = core,
	})
	add(rig, {
		name = "Halo",
		size = V(1.2, 1.2, 1.2),
		cf = CFrame.new(core.Position / rig.scale),
		color = glowColor,
		material = Enum.Material.Neon,
		transparency = 0.9,
	})
	local attachment = create("Attachment", { Parent = body })
	create("ParticleEmitter", {
		Rate = 5,
		Lifetime = NumberRange.new(1, 1.8),
		Speed = NumberRange.new(0.4, 1),
		SpreadAngle = Vector2.new(180, 180),
		Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.18 * rig.scale), NumberSequenceKeypoint.new(1, 0) }),
		Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.1), NumberSequenceKeypoint.new(1, 1) }),
		Color = ColorSequence.new(glowColor),
		LightEmission = 1,
		LightInfluence = 0,
		Parent = attachment,
	})
end

function BugBuilder.build(bug, options)
	local rig = {
		model = create("Model", { Name = bug.Name }),
		parts = {},
		glow = {},
		rainbow = {},
		scale = BugBuilder.scale(bug),
		bug = bug,
		light = nil,
	}
	BUILDERS[bug.Shape](rig, bug)
	if options and options.effects and BugData.Rarities[bug.Rarity].Glow then
		addGlow(rig, bug)
	end
	return rig
end

return BugBuilder
]]></ProtectedString>
			</Properties>
		</Item>
		<Item class="ModuleScript" referent="RBX6">
			<Properties>
				<string name="Name">NetBuilder</string>
				<ProtectedString name="Source"><![CDATA[--[[
	NetBuilder: builds the bug net Tool.

	Layout (the Handle's own space): the pole runs along +Y, the hand holds
	it 1 stud below the Handle's centre, and the hoop sits on top facing -Z
	with the mesh bag trailing behind it (+Z). Tool.Grip tilts the pole
	forward so the net is held up and ready.

	Usage (server):
		local net = NetBuilder.build(Config)
		net.Parent = game:GetService("StarterPack")
]]

local Util = require(script.Parent:WaitForChild("Util"))
local create, ellipsoid = Util.create, Util.ellipsoid

local NetBuilder = {}

local WOOD = Color3.fromRGB(150, 104, 62)
local GRIP = Color3.fromRGB(70, 46, 34)
local METAL = Color3.fromRGB(200, 204, 210)
local MESH = Color3.fromRGB(246, 246, 238)

local POLE_LENGTH = 4.6
local HOOP_RADIUS = 1.15
NetBuilder.HoopCenter = Vector3.new(0, POLE_LENGTH / 2 + HOOP_RADIUS, 0)

function NetBuilder.build(config)
	local tool = create("Tool", {
		Name = config.NetName,
		ToolTip = "Click or tap to swing",
		CanBeDropped = false,
		RequiresHandle = true,
		-- Hold the pole leaning 55 degrees forward, gripped 1 stud below its middle.
		Grip = (CFrame.Angles(math.rad(-55), 0, 0) * CFrame.new(0, 1, 0)):Inverse(),
	})

	local handle = create("Part", {
		Name = "Handle",
		Size = Vector3.new(0.2, POLE_LENGTH, 0.2),
		Transparency = 1,
		CanCollide = false,
		CanQuery = false,
		CanTouch = false,
		Massless = true,
		CFrame = CFrame.identity,
		Parent = tool,
	})

	local function piece(props)
		local part = create("Part", {
			CanCollide = false,
			CanQuery = false,
			CanTouch = false,
			Massless = true,
			TopSurface = Enum.SurfaceType.Smooth,
			BottomSurface = Enum.SurfaceType.Smooth,
		})
		for key, value in props do
			part[key] = value
		end
		part.Parent = tool
		create("WeldConstraint", { Part0 = handle, Part1 = part, Parent = part })
		return part
	end

	local alongY = CFrame.Angles(0, 0, math.pi / 2) -- turns a cylinder's X axis to +Y

	piece({
		Name = "Pole",
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(POLE_LENGTH, 0.2, 0.2),
		CFrame = alongY,
		Color = WOOD,
		Material = Enum.Material.Wood,
	})
	piece({
		Name = "GripWrap",
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(1.1, 0.27, 0.27),
		CFrame = CFrame.new(0, -1, 0) * alongY,
		Color = GRIP,
		Material = Enum.Material.Fabric,
	})
	piece({
		Name = "EndCap",
		Shape = Enum.PartType.Ball,
		Size = Vector3.one * 0.3,
		CFrame = CFrame.new(0, -POLE_LENGTH / 2, 0),
		Color = GRIP,
	})
	piece({
		Name = "Collar",
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(0.4, 0.26, 0.26),
		CFrame = CFrame.new(0, POLE_LENGTH / 2 - 0.1, 0) * alongY,
		Color = METAL,
		Material = Enum.Material.Metal,
	})

	-- The hoop: a ring of short metal segments.
	local center = NetBuilder.HoopCenter
	local segments = 18
	for i = 1, segments do
		local angle = i / segments * math.pi * 2
		local position = center + Vector3.new(math.cos(angle), math.sin(angle), 0) * HOOP_RADIUS
		piece({
			Name = "Hoop",
			Shape = Enum.PartType.Cylinder,
			Size = Vector3.new(2 * math.pi * HOOP_RADIUS / segments * 1.12, 0.11, 0.11),
			CFrame = CFrame.new(position) * CFrame.Angles(0, 0, angle + math.pi / 2),
			Color = METAL,
			Material = Enum.Material.Metal,
		})
	end

	-- The mesh bag trails behind the hoop: a wide mouth tapering to a drooping tip.
	for _, bag in {
		{ name = "Bag", size = Vector3.new(HOOP_RADIUS * 1.9, HOOP_RADIUS * 1.9, 1.3), offset = Vector3.new(0, -0.05, 0.5) },
		{ name = "BagTip", size = Vector3.new(1.25, 1.2, 1.7), offset = Vector3.new(0, -0.35, 1.3) },
	} do
		ellipsoid(piece({
			Name = bag.name,
			Size = bag.size,
			CFrame = CFrame.new(center + bag.offset),
			Color = MESH,
			Material = Enum.Material.Fabric,
			Transparency = 0.4,
			CastShadow = false,
		}))
	end

	-- A faint swoosh trail drawn by the hoop during a swing (switched on by NetClient).
	local a0 = create("Attachment", { Name = "TrailBottom", Position = center - Vector3.new(0, HOOP_RADIUS, 0), Parent = handle })
	local a1 = create("Attachment", { Name = "TrailTop", Position = center + Vector3.new(0, HOOP_RADIUS, 0), Parent = handle })
	create("Trail", {
		Name = "SwingTrail",
		Attachment0 = a0,
		Attachment1 = a1,
		Enabled = false,
		Lifetime = 0.18,
		MinLength = 0.05,
		FaceCamera = true,
		LightEmission = 0.3,
		Color = ColorSequence.new(Color3.new(1, 1, 1)),
		Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.55), NumberSequenceKeypoint.new(1, 1) }),
		Parent = handle,
	})

	create("Sound", {
		Name = "SwingSound",
		SoundId = config.Sounds.Swing,
		Volume = 0.55,
		PlaybackSpeed = 1.25,
		RollOffMaxDistance = 60,
		Parent = handle,
	})

	return tool
end

return NetBuilder
]]></ProtectedString>
			</Properties>
		</Item>
		<Item class="ModuleScript" referent="RBX7">
			<Properties>
				<string name="Name">Collection</string>
				<ProtectedString name="Source"><![CDATA[--[[
	Collection (server only): which bugs each player has caught.

	The server is the only one that changes it. Each player's collection is
	shared with clients as a JSON attribute on the Player ("BugCollection"),
	which the collection book reads, and as a "Bugs" leaderboard stat
	(how many different bugs they've found).
]]

local HttpService = game:GetService("HttpService")

local folder = script.Parent
local BugData = require(folder:WaitForChild("BugData"))
local Util = require(folder:WaitForChild("Util"))
local create = Util.create

local Collection = {}

local profiles = {} -- [player] = { caught = { [bugId] = timesCaught } }

local function uniqueCount(caught)
	local count = 0
	for bugId in caught do
		if BugData.ById[bugId] then
			count += 1
		end
	end
	return count
end

-- Sends the collection to clients and updates the leaderboard.
local function publish(player, profile)
	player:SetAttribute("BugCollection", HttpService:JSONEncode(profile.caught))
	local stats = player:FindFirstChild("leaderstats")
	local found = stats and stats:FindFirstChild("Bugs")
	if found then
		found.Value = uniqueCount(profile.caught)
	end
end

function Collection.setup(player)
	if profiles[player] then
		return profiles[player]
	end
	local profile = { caught = {} }
	profiles[player] = profile
	local stats = player:FindFirstChild("leaderstats") or create("Folder", { Name = "leaderstats", Parent = player })
	if not stats:FindFirstChild("Bugs") then
		create("IntValue", { Name = "Bugs", Parent = stats })
	end
	publish(player, profile)
	return profile
end

function Collection.get(player)
	return profiles[player]
end

-- Records a catch. Returns whether it's a new bug for this player and how many they've caught.
function Collection.add(player, bugId)
	local profile = profiles[player] or Collection.setup(player)
	local count = (profile.caught[bugId] or 0) + 1
	profile.caught[bugId] = count
	profile.dirty = true
	publish(player, profile)
	return count == 1, count
end

function Collection.remove(player)
	profiles[player] = nil
end

return Collection
]]></ProtectedString>
			</Properties>
		</Item>
		<Item class="ModuleScript" referent="RBX8">
			<Properties>
				<string name="Name">FieldBuilder</string>
				<ProtectedString name="Source"><![CDATA[--[[
	FieldBuilder

	Builds the meadow: a flat grass field (Terrain) ringed by rolling hills,
	with patches of darker grass, flowers, bushes, rocks and trees. Ground
	level inside the field is y = 0. Everything is generated from Config.Seed,
	so every server gets the same layout.

	Usage (server):
		FieldBuilder.build(Config)
]]

local Workspace = game:GetService("Workspace")

local Util = require(script.Parent:WaitForChild("Util"))
local create, decor, ellipsoid, upright = Util.create, Util.decor, Util.ellipsoid, Util.upright

local FieldBuilder = {}

local FLOWERS = {
	{ name = "Daisy", petal = Color3.fromRGB(250, 250, 244), center = Color3.fromRGB(250, 200, 40), height = { 1.1, 1.7 }, size = 1 },
	{ name = "Poppy", petal = Color3.fromRGB(222, 46, 38), center = Color3.fromRGB(40, 30, 30), height = { 1.4, 2.1 }, size = 1.05 },
	{ name = "Bluebell", petal = Color3.fromRGB(96, 110, 228), center = Color3.fromRGB(246, 226, 120), height = { 1, 1.5 }, size = 0.85 },
	{ name = "Cosmos", petal = Color3.fromRGB(246, 128, 186), center = Color3.fromRGB(250, 214, 70), height = { 1.5, 2.3 }, size = 1.1 },
	{ name = "Buttercup", petal = Color3.fromRGB(255, 214, 40), center = Color3.fromRGB(226, 160, 20), height = { 0.9, 1.4 }, size = 0.8 },
	{ name = "Sunflower", petal = Color3.fromRGB(255, 196, 22), center = Color3.fromRGB(92, 56, 26), height = { 3.6, 4.6 }, size = 2.1 },
}

local STEM_COLOR = Color3.fromRGB(70, 130, 50)

-- A random point inside a ring around the origin, spread evenly over its area.
local function randomPoint(rng, minRadius, maxRadius)
	local angle = rng:NextNumber(0, math.pi * 2)
	local radius = math.sqrt(rng:NextNumber((minRadius / maxRadius) ^ 2, 1)) * maxRadius
	return Vector3.new(math.cos(angle) * radius, 0, math.sin(angle) * radius)
end

local groundParams = RaycastParams.new()
groundParams.FilterType = Enum.RaycastFilterType.Include

-- The terrain height under a point (the field itself is flat at 0; hills aren't).
local function groundAt(point)
	groundParams.FilterDescendantsInstances = { Workspace.Terrain }
	local result = Workspace:Raycast(Vector3.new(point.X, 200, point.Z), Vector3.new(0, -400, 0), groundParams)
	return Vector3.new(point.X, result and result.Position.Y or 0, point.Z)
end

local function buildTerrain(config, rng)
	local terrain = Workspace.Terrain
	local radius = config.FieldRadius

	terrain:SetMaterialColor(Enum.Material.Grass, Color3.fromRGB(96, 148, 60))
	terrain:SetMaterialColor(Enum.Material.LeafyGrass, Color3.fromRGB(76, 126, 50))

	-- The ground: a 16-stud thick slab whose top sits exactly on y = 0 (voxels are 4 studs).
	local size = (radius + 180) * 2
	terrain:FillBlock(CFrame.new(0, -8, 0), Vector3.new(size, 16, size), Enum.Material.Grass)

	-- Patches of darker, leafier grass. ReplaceMaterial only repaints, so the ground stays flat.
	for _ = 1, 16 do
		local center = randomPoint(rng, 0, radius)
		for _ = 1, 4 do
			local offset = Vector3.new(rng:NextNumber(-10, 10), 0, rng:NextNumber(-10, 10))
			local half = Vector3.new(rng:NextNumber(5, 12), 2, rng:NextNumber(5, 12))
			local region = Region3.new(center + offset - half - Vector3.new(0, 2, 0), center + offset + half)
			terrain:ReplaceMaterial(region:ExpandToGrid(4), 4, Enum.Material.Grass, Enum.Material.LeafyGrass)
		end
	end

	-- Two rings of rolling hills around the meadow.
	for ring = 1, 2 do
		local count = ring == 1 and 34 or 26
		for i = 1, count do
			local angle = (i + rng:NextNumber(-0.4, 0.4)) / count * math.pi * 2
			local hillRadius = ring == 1 and rng:NextNumber(18, 34) or rng:NextNumber(36, 58)
			local distance = radius + (ring == 1 and rng:NextNumber(30, 55) or rng:NextNumber(85, 120))
			local center = Vector3.new(math.cos(angle) * distance, -hillRadius * 0.55, math.sin(angle) * distance)
			terrain:FillBall(center, hillRadius, Enum.Material.Grass)
		end
	end
end

local function buildTree(parent, rng, position)
	local model = create("Model", { Name = "Tree" })
	local height = rng:NextNumber(11, 18)
	local width = rng:NextNumber(1.3, 2)
	local birch = rng:NextNumber() < 0.25
	local bark = birch and Color3.fromRGB(226, 222, 210) or Color3.fromRGB(102, 74, 50)

	local trunk = decor({
		Name = "Trunk",
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(height + 1, width, width),
		CFrame = upright(position + Vector3.new(0, height / 2 - 0.5, 0)),
		Material = Enum.Material.Wood,
		Color = bark,
		CanCollide = true,
		CanQuery = true,
		Parent = model,
	})
	model.PrimaryPart = trunk
	decor({
		Name = "Flare",
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(1.6, width * 1.35, width * 1.35),
		CFrame = upright(position + Vector3.new(0, 0.3, 0)),
		Material = Enum.Material.Wood,
		Color = bark,
		Parent = model,
	})

	-- Two branches reaching up into the leaves.
	for i = 1, 2 do
		local yaw = rng:NextNumber(0, math.pi * 2) + i * math.pi
		local base = position + Vector3.new(0, height * rng:NextNumber(0.55, 0.7), 0)
		local branch = CFrame.new(base) * CFrame.Angles(0, yaw, 0) * CFrame.Angles(0, 0, math.rad(55))
		decor({
			Name = "Branch",
			Shape = Enum.PartType.Cylinder,
			Size = Vector3.new(4.5, width * 0.45, width * 0.45),
			CFrame = branch * CFrame.new(2, 0, 0),
			Material = Enum.Material.Wood,
			Color = bark,
			Parent = model,
		})
	end

	-- A cloud of leaf balls on top.
	local hue = birch and rng:NextNumber(0.2, 0.24) or rng:NextNumber(0.24, 0.3)
	local top = position + Vector3.new(0, height, 0)
	local leafCount = rng:NextInteger(5, 7)
	for i = 1, leafCount do
		local size = i == 1 and rng:NextNumber(9, 12) or rng:NextNumber(6, 9)
		local offset = i == 1 and Vector3.zero
			or Vector3.new(rng:NextNumber(-3.8, 3.8), rng:NextNumber(-2.2, 2), rng:NextNumber(-3.8, 3.8))
		decor({
			Name = "Leaves",
			Shape = Enum.PartType.Ball,
			Size = Vector3.one * size,
			CFrame = CFrame.new(top + offset),
			Material = Enum.Material.LeafyGrass,
			Color = Color3.fromHSV(hue + rng:NextNumber(-0.02, 0.02), rng:NextNumber(0.5, 0.65), rng:NextNumber(0.42, 0.56)),
			Parent = model,
		})
	end
	model.Parent = parent
end

local function buildBush(parent, rng, position)
	local model = create("Model", { Name = "Bush" })
	local hue = rng:NextNumber(0.23, 0.3)
	for _ = 1, rng:NextInteger(2, 4) do
		local size = rng:NextNumber(3, 5.5)
		local offset = Vector3.new(rng:NextNumber(-1.8, 1.8), size * 0.22, rng:NextNumber(-1.8, 1.8))
		decor({
			Name = "Leaves",
			Shape = Enum.PartType.Ball,
			Size = Vector3.one * size,
			CFrame = CFrame.new(position + offset),
			Material = Enum.Material.LeafyGrass,
			Color = Color3.fromHSV(hue, rng:NextNumber(0.5, 0.65), rng:NextNumber(0.4, 0.52)),
			Parent = model,
		})
	end
	model.Parent = parent
end

local function buildRock(parent, rng, position)
	local size = Vector3.new(rng:NextNumber(2.5, 6), rng:NextNumber(1.6, 3.2), rng:NextNumber(2.5, 5))
	local grey = rng:NextNumber(105, 135)
	ellipsoid(decor({
		Name = "Rock",
		Size = size,
		CFrame = CFrame.new(position + Vector3.new(0, size.Y * 0.2, 0))
			* CFrame.Angles(rng:NextNumber(-0.2, 0.2), rng:NextNumber(0, math.pi * 2), rng:NextNumber(-0.2, 0.2)),
		Material = Enum.Material.Rock,
		Color = Color3.fromRGB(grey, grey - 2, grey - 8),
		CanCollide = true,
		CastShadow = true,
		Parent = parent,
	}))
end

local function buildFlower(parent, rng, species, position)
	local model = create("Model", { Name = species.name })
	local height = rng:NextNumber(species.height[1], species.height[2])
	local s = species.size * rng:NextNumber(0.85, 1.15)
	local tilt = CFrame.Angles(rng:NextNumber(-0.25, 0.25), 0, rng:NextNumber(-0.25, 0.25))
	local base = CFrame.new(position) * CFrame.Angles(0, rng:NextNumber(0, math.pi * 2), 0) * tilt

	decor({
		Name = "Stem",
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(height, 0.12 * math.max(1, s * 0.8), 0.12 * math.max(1, s * 0.8)),
		CFrame = base * CFrame.new(0, height / 2, 0) * CFrame.Angles(0, 0, math.pi / 2),
		Color = STEM_COLOR,
		Material = Enum.Material.SmoothPlastic,
		CastShadow = false,
		Parent = model,
	})
	ellipsoid(decor({
		Name = "Leaf",
		Size = Vector3.new(0.55, 0.05, 0.22) * math.max(1, s * 0.8),
		CFrame = base * CFrame.new(0.22, height * 0.35, 0) * CFrame.Angles(0, 0, math.rad(25)),
		Color = STEM_COLOR,
		Material = Enum.Material.SmoothPlastic,
		CastShadow = false,
		Parent = model,
	}))

	-- The head faces the sky. Three crossing petal ovals make six petals.
	local head = base * CFrame.new(0, height, 0) * CFrame.Angles(math.rad(-15), 0, 0)
	for i = 0, 2 do
		ellipsoid(decor({
			Name = "Petals",
			Size = Vector3.new(0.3 * s, 0.07 * s, 1.15 * s),
			CFrame = head * CFrame.Angles(0, i * math.pi / 3, 0),
			Color = species.petal,
			Material = Enum.Material.SmoothPlastic,
			CastShadow = false,
			Parent = model,
		}))
	end
	ellipsoid(decor({
		Name = "Center",
		Size = Vector3.new(0.38, 0.18, 0.38) * s,
		CFrame = head * CFrame.new(0, 0.04 * s, 0),
		Color = species.center,
		Material = Enum.Material.SmoothPlastic,
		CastShadow = false,
		Parent = model,
	}))
	model.Parent = parent
end

-- A tuft of long grass blades leaning out in all directions.
local function buildTuft(parent, rng, position)
	local model = create("Model", { Name = "Grass" })
	local hue = rng:NextNumber(0.24, 0.29)
	for i = 1, 4 do
		local height = rng:NextNumber(1.2, 2.4)
		local yaw = i / 4 * math.pi * 2 + rng:NextNumber(-0.4, 0.4)
		local lean = rng:NextNumber(0.15, 0.45)
		decor({
			Name = "Blade",
			Size = Vector3.new(0.06, height, 0.32),
			CFrame = CFrame.new(position) * CFrame.Angles(0, yaw, 0) * CFrame.Angles(lean, 0, 0) * CFrame.new(0, height / 2, 0),
			Color = Color3.fromHSV(hue, rng:NextNumber(0.5, 0.65), rng:NextNumber(0.5, 0.62)),
			Material = Enum.Material.SmoothPlastic,
			CastShadow = false,
			Parent = model,
		})
	end
	model.Parent = parent
end

-- An invisible wall far out in the hills so nobody walks off the edge of the world.
local function buildBoundary(parent, radius)
	local count = 48
	local distance = radius + 150
	local width = 2 * math.pi * distance / count + 4
	for i = 1, count do
		local angle = i / count * math.pi * 2
		local position = Vector3.new(math.cos(angle) * distance, 60, math.sin(angle) * distance)
		create("Part", {
			Name = "Wall",
			Anchored = true,
			Transparency = 1,
			CanQuery = false,
			CanTouch = false,
			CastShadow = false,
			Size = Vector3.new(width, 160, 4),
			CFrame = CFrame.lookAt(position, Vector3.new(0, 60, 0)),
			Parent = parent,
		})
	end
end

function FieldBuilder.build(config)
	local rng = Random.new(config.Seed)
	local radius = config.FieldRadius

	local old = Workspace:FindFirstChild("BugField")
	if old then
		old:Destroy()
	end
	if config.RemoveBaseplate then
		local baseplate = Workspace:FindFirstChild("Baseplate")
		if baseplate and baseplate:IsA("BasePart") then
			baseplate:Destroy()
		end
	end

	buildTerrain(config, rng)

	local root = create("Folder", { Name = "BugField" })
	local trees = create("Folder", { Name = "Trees", Parent = root })
	local plants = create("Folder", { Name = "Plants", Parent = root })
	local flowers = create("Folder", { Name = "Flowers", Parent = root })
	buildBoundary(create("Folder", { Name = "Boundary", Parent = root }), radius)

	-- Trees keep their distance from each other and from the spawn in the middle.
	local placed = {}
	for _ = 1, config.TreeCount do
		for _ = 1, 30 do
			local point = randomPoint(rng, 30, radius + 45)
			local free = true
			for _, other in placed do
				if (other - point).Magnitude < 16 then
					free = false
					break
				end
			end
			if free then
				table.insert(placed, point)
				buildTree(trees, rng, groundAt(point))
				break
			end
		end
	end

	for _ = 1, config.BushCount do
		buildBush(plants, rng, groundAt(randomPoint(rng, 14, radius + 30)))
	end
	for _ = 1, config.RockCount do
		buildRock(plants, rng, groundAt(randomPoint(rng, 18, radius + 30)))
	end

	for _ = 1, config.GrassTufts do
		buildTuft(plants, rng, randomPoint(rng, 6, radius))
	end

	-- Flowers grow in patches of one kind, like a real meadow.
	for _ = 1, config.FlowerPatches do
		local species = FLOWERS[rng:NextInteger(1, #FLOWERS)]
		local center = randomPoint(rng, 8, radius - 5)
		local spread = rng:NextNumber(4, 9)
		local count = species.name == "Sunflower" and rng:NextInteger(3, 6) or rng:NextInteger(7, 14)
		for _ = 1, count do
			local offset = randomPoint(rng, 0, spread)
			buildFlower(flowers, rng, species, center + offset)
		end
	end

	root.Parent = Workspace
	return root
end

return FieldBuilder
]]></ProtectedString>
			</Properties>
		</Item>
		<Item class="Script" referent="RBX9">
			<Properties>
				<string name="Name">WorldServer</string>
				<token name="RunContext">1</token>
				<ProtectedString name="Source"><![CDATA[--[[
	World server: builds the meadow, sets up realistic lighting, starts the
	day/night clock and decides when it rains. WorldClient does the visuals.
	This is a Script with RunContext = Server, so it runs from ReplicatedStorage.
]]

local Lighting = game:GetService("Lighting")
local Workspace = game:GetService("Workspace")

local folder = script.Parent
local Config = require(folder:WaitForChild("Config"))
local Environment = require(folder:WaitForChild("Environment"))
local FieldBuilder = require(folder:WaitForChild("FieldBuilder"))
local Util = require(folder:WaitForChild("Util"))
local create = Util.create

local function findOrCreate(parent, className, props)
	local instance = parent:FindFirstChildOfClass(className)
	if not instance then
		return create(className, props)
	end
	for key, value in props do
		if key ~= "Parent" then
			instance[key] = value
		end
	end
	return instance
end

local function setupLighting()
	-- Soft, realistic sunlight. LightingStyle is new; older engines just skip it.
	pcall(function()
		Lighting.LightingStyle = Enum.LightingStyle.Realistic
	end)
	Lighting.GlobalShadows = true
	Lighting.ShadowSoftness = 0.35
	Lighting.Brightness = 2.4
	Lighting.EnvironmentDiffuseScale = 1
	Lighting.EnvironmentSpecularScale = 1
	Lighting.Ambient = Color3.fromRGB(70, 72, 82)
	Lighting.OutdoorAmbient = Color3.fromRGB(128, 128, 136)
	Lighting.ExposureCompensation = 0
	Lighting.GeographicLatitude = 35
	Lighting.ClockTime = Config.StartClockTime

	findOrCreate(Lighting, "Sky", {
		StarCount = 3000,
		SunAngularSize = 14,
		MoonAngularSize = 9,
		CelestialBodiesShown = true,
		Parent = Lighting,
	})
	-- Atmosphere gives the light fog and the hazy horizon.
	findOrCreate(Lighting, "Atmosphere", {
		Density = 0.3,
		Offset = 0.25,
		Color = Color3.fromRGB(199, 212, 226),
		Decay = Color3.fromRGB(106, 124, 148),
		Glare = 0.3,
		Haze = 1.2,
		Parent = Lighting,
	})
	findOrCreate(Lighting, "BloomEffect", {
		Intensity = 0.5,
		Size = 24,
		Threshold = 1.6,
		Parent = Lighting,
	})
	findOrCreate(Lighting, "ColorCorrectionEffect", {
		Contrast = 0.06,
		Saturation = 0.12,
		TintColor = Color3.new(1, 1, 1),
		Parent = Lighting,
	})
	findOrCreate(Lighting, "SunRaysEffect", {
		Intensity = 0.05,
		Spread = 0.7,
		Parent = Lighting,
	})
	findOrCreate(Workspace.Terrain, "Clouds", {
		Cover = 0.55,
		Density = 0.55,
		Color = Color3.new(1, 1, 1),
		Parent = Workspace.Terrain,
	})
end

-- Day/night: clients and the bug spawner work out the time from this one value.
local function startClock()
	local sunrise = Workspace:GetServerTimeNow() - Environment.secondsAfterSunrise(Config.StartClockTime)
	folder:SetAttribute("SunriseTime", sunrise)
end

-- Weather: every so often there's a chance of a shower.
local function runWeather()
	local rng = Random.new()
	folder:SetAttribute("Raining", false)
	while true do
		task.wait(Config.RainCheckSeconds)
		if rng:NextNumber() < Config.RainChance then
			folder:SetAttribute("Raining", true)
			task.wait(rng:NextNumber(Config.RainSeconds[1], Config.RainSeconds[2]))
			folder:SetAttribute("Raining", false)
		end
	end
end

setupLighting()
startClock()
FieldBuilder.build(Config)
task.spawn(runWeather)
]]></ProtectedString>
			</Properties>
		</Item>
		<Item class="Script" referent="RBX10">
			<Properties>
				<string name="Name">WorldClient</string>
				<token name="RunContext">2</token>
				<ProtectedString name="Source"><![CDATA[--[[
	World client: everything about the world you see and hear.

	  * Moves the sun and moon and blends the lighting between day, dusk,
	    night and rain (soft shadows, light fog, clouds, colour grading).
	  * Rain: falling streaks around the camera, splashes on the grass and
	    a looping rain sound.
	  * Footsteps on the grass for every player.

	This is a Script with RunContext = Client, so it runs from ReplicatedStorage.
]]

local Lighting = game:GetService("Lighting")
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local SoundService = game:GetService("SoundService")
local UserInputService = game:GetService("UserInputService")
local Workspace = game:GetService("Workspace")

local folder = script.Parent
local Config = require(folder:WaitForChild("Config"))
local Environment = require(folder:WaitForChild("Environment"))
local Util = require(folder:WaitForChild("Util"))
local create, lerp, smooth = Util.create, Util.lerp, Util.smooth

local isMobile = UserInputService.TouchEnabled and not UserInputService.KeyboardEnabled

local function waitForClass(parent, className)
	local found = parent:FindFirstChildOfClass(className)
	local started = os.clock()
	while not found and os.clock() - started < 10 do
		task.wait(0.2)
		found = parent:FindFirstChildOfClass(className)
	end
	return found
end

local atmosphere = waitForClass(Lighting, "Atmosphere")
local bloom = waitForClass(Lighting, "BloomEffect")
local grading = waitForClass(Lighting, "ColorCorrectionEffect")
local sunRays = waitForClass(Lighting, "SunRaysEffect")
local clouds = waitForClass(Workspace.Terrain, "Clouds")

local function rgb(r, g, b)
	return Color3.fromRGB(r, g, b)
end

-- Lighting looks: { day, night, rain }. Rain blends over whichever of day/night it is.
local LOOK = {
	OutdoorAmbient = { rgb(128, 128, 136), rgb(58, 68, 108), rgb(108, 112, 120) },
	Ambient = { rgb(70, 72, 82), rgb(28, 32, 52), rgb(62, 64, 70) },
	AtmosphereColor = { rgb(199, 212, 226), rgb(46, 56, 86), rgb(150, 156, 166) },
	AtmosphereDecay = { rgb(106, 124, 148), rgb(28, 34, 56), rgb(110, 116, 126) },
	Tint = { rgb(255, 255, 255), rgb(196, 210, 255), rgb(226, 232, 240) },
	CloudColor = { rgb(255, 255, 255), rgb(120, 130, 160), rgb(150, 154, 162) },
}
local DUSK_TINT = rgb(255, 222, 196)

-- --------------------------------------------------------------- day, night and lighting

local rain = 0 -- 0 = dry, 1 = full rain; eases in and out

local function updateLighting(dt)
	local clock = Environment.getClockTime()
	Lighting.ClockTime = clock

	local target = Environment.isRaining() and 1 or 0
	rain += math.clamp(target - rain, -dt / 6, dt / 6)

	local sunHeight = math.sin((clock - 6) / 12 * math.pi) -- 1 at noon, -1 at midnight
	local day = math.clamp(sunHeight * 4 + 0.25, 0, 1)
	local dusk = math.clamp(1 - math.abs(sunHeight) * 3.5, 0, 1)

	local function look(name)
		local values = LOOK[name]
		local base = values[2]:Lerp(values[1], day)
		local wet = values[3]:Lerp(values[2], (1 - day) * 0.7)
		return base:Lerp(wet, rain)
	end

	Lighting.Brightness = lerp(1.1, 2.4, day) * (1 - 0.45 * rain)
	Lighting.OutdoorAmbient = look("OutdoorAmbient")
	Lighting.Ambient = look("Ambient")

	if atmosphere then
		atmosphere.Color = look("AtmosphereColor")
		atmosphere.Decay = look("AtmosphereDecay")
		atmosphere.Density = 0.3 + 0.17 * rain
		atmosphere.Haze = 1.2 + 1.6 * rain
		atmosphere.Glare = 0.3 * day * (1 - rain)
	end
	if grading then
		grading.TintColor = look("Tint"):Lerp(DUSK_TINT, dusk * 0.6 * (1 - rain))
		grading.Saturation = lerp(-0.12, 0.12, day) - 0.22 * rain
		grading.Contrast = 0.06
	end
	if bloom then
		-- Lower threshold at night so glowing bugs bloom more.
		bloom.Threshold = lerp(1.05, 1.6, day)
		bloom.Intensity = lerp(0.9, 0.5, day)
	end
	if sunRays then
		sunRays.Intensity = 0.05 * day * (1 - rain)
	end
	if clouds then
		clouds.Cover = 0.55 + 0.4 * rain
		clouds.Density = 0.55 + 0.35 * rain
		clouds.Color = look("CloudColor")
	end
end

-- --------------------------------------------------------------- rain

local DROP_COUNT = isMobile and 110 or 220
local DROP_VELOCITY = Vector3.new(5, -85, 2.5)
local DROP_AREA = 55 -- half-width of the box of rain around the camera
local PARKED = CFrame.new(0, -500, 0)

-- Turn each streak to match the slant of the falling rain.
local slant = -DROP_VELOCITY.Unit
local slantAxis = Vector3.yAxis:Cross(slant)
local DROP_ROTATION = slantAxis.Magnitude > 1e-4
		and CFrame.fromAxisAngle(slantAxis.Unit, math.acos(Vector3.yAxis:Dot(slant)))
	or CFrame.identity

local rainFolder = create("Folder", { Name = "BugCatcherRain", Parent = Workspace })
local drops = {}
for i = 1, DROP_COUNT do
	drops[i] = {
		part = create("Part", {
			Name = "Drop",
			Anchored = true,
			CanCollide = false,
			CanQuery = false,
			CanTouch = false,
			CastShadow = false,
			Material = Enum.Material.SmoothPlastic,
			Color = rgb(196, 210, 228),
			Transparency = 0.55,
			Size = Vector3.new(0.05, 1.7, 0.05),
			CFrame = PARKED,
			Parent = rainFolder,
		}),
		position = nil,
	}
end

local splashPart = create("Part", {
	Name = "Splashes",
	Anchored = true,
	CanCollide = false,
	CanQuery = false,
	CanTouch = false,
	Transparency = 1,
	Size = Vector3.new(DROP_AREA * 1.6, 0.2, DROP_AREA * 1.6),
	CFrame = PARKED,
	Parent = rainFolder,
})
local splashes = create("ParticleEmitter", {
	Rate = 0,
	Lifetime = NumberRange.new(0.15, 0.3),
	Speed = NumberRange.new(2, 4),
	SpreadAngle = Vector2.new(35, 35),
	EmissionDirection = Enum.NormalId.Top,
	Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.28), NumberSequenceKeypoint.new(1, 0.04) }),
	Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.35), NumberSequenceKeypoint.new(1, 1) }),
	Color = ColorSequence.new(rgb(220, 232, 255)),
	Acceleration = Vector3.new(0, -25, 0),
	LightInfluence = 1,
	Parent = splashPart,
})

local rainSound = create("Sound", {
	Name = "Rain",
	SoundId = Config.Sounds.Rain,
	Looped = true,
	Volume = 0,
	Parent = SoundService,
})

local rng = Random.new()

local function respawnDrop(drop, cameraPosition, anywhereInColumn)
	local fallTime = rng:NextNumber(0.2, 0.6)
	local x = cameraPosition.X + rng:NextNumber(-DROP_AREA, DROP_AREA) - DROP_VELOCITY.X * fallTime
	local z = cameraPosition.Z + rng:NextNumber(-DROP_AREA, DROP_AREA) - DROP_VELOCITY.Z * fallTime
	local y = cameraPosition.Y + (anywhereInColumn and rng:NextNumber(-25, 45) or rng:NextNumber(30, 50))
	drop.position = Vector3.new(x, y, z)
end

local activeDrops = 0

local function updateRain(dt)
	local camera = Workspace.CurrentCamera
	if not camera then
		return
	end
	local cameraPosition = camera.CFrame.Position
	local wanted = math.floor(DROP_COUNT * rain + 0.5)

	local parts, cframes = {}, {}
	for i, drop in drops do
		if i <= wanted then
			if not drop.position then
				respawnDrop(drop, cameraPosition, true)
			end
			local position = drop.position + DROP_VELOCITY * dt
			if position.Y < -1 or position.Y < cameraPosition.Y - 40 then
				respawnDrop(drop, cameraPosition, false)
				position = drop.position
			end
			drop.position = position
			table.insert(parts, drop.part)
			table.insert(cframes, CFrame.new(position) * DROP_ROTATION)
		elseif i <= activeDrops then
			-- This drop just switched off: park it out of sight once.
			drop.position = nil
			table.insert(parts, drop.part)
			table.insert(cframes, PARKED)
		end
	end
	activeDrops = wanted
	if #parts > 0 then
		Workspace:BulkMoveTo(parts, cframes, Enum.BulkMoveMode.FireCFrameChanged)
	end

	splashes.Rate = (isMobile and 140 or 260) * rain
	splashPart.CFrame = rain > 0 and CFrame.new(cameraPosition.X, 0.15, cameraPosition.Z) or PARKED

	rainSound.Volume = Config.RainVolume * rain
	if rain > 0.01 and not rainSound.IsPlaying then
		rainSound:Play()
	elseif rain <= 0.01 and rainSound.IsPlaying then
		rainSound:Stop()
	end
end

-- --------------------------------------------------------------- footsteps

-- Roblox's default footsteps sound like plastic. Each character gets a softer,
-- muffled loop that only plays while it walks on the ground.
local walkers = {}

local function addCharacter(character)
	local root = character:WaitForChild("HumanoidRootPart", 10)
	local humanoid = character:WaitForChild("Humanoid", 10)
	if not root or not humanoid or Config.Sounds.Footsteps == "" then
		return
	end
	local steps = create("Sound", {
		Name = "GrassSteps",
		SoundId = Config.Sounds.Footsteps,
		Looped = true,
		Volume = 0,
		RollOffMaxDistance = 60,
		Parent = root,
	})
	create("EqualizerSoundEffect", { HighGain = -12, MidGain = -2, LowGain = 3, Parent = steps })
	steps:Play()
	walkers[character] = { root = root, humanoid = humanoid, sound = steps, volume = 0 }
end

local function watchPlayer(player)
	player.CharacterAdded:Connect(addCharacter)
	if player.Character then
		task.spawn(addCharacter, player.Character)
	end
end

Players.PlayerAdded:Connect(watchPlayer)
for _, player in Players:GetPlayers() do
	watchPlayer(player)
end

local function updateFootsteps(dt)
	for character, walker in walkers do
		if not character.Parent or not walker.root.Parent then
			walkers[character] = nil
			continue
		end
		local defaultSteps = walker.root:FindFirstChild("Running")
		if defaultSteps and defaultSteps:IsA("Sound") then
			defaultSteps.Volume = 0
		end
		local velocity = walker.root.AssemblyLinearVelocity
		local speed = Vector3.new(velocity.X, 0, velocity.Z).Magnitude
		local grounded = math.abs(velocity.Y) < 2 and walker.humanoid.Health > 0
		local target = (grounded and speed > 1.5) and Config.FootstepVolume * math.clamp(speed / 16, 0.4, 1.2) or 0
		walker.volume = lerp(walker.volume, target, smooth(18, dt))
		walker.sound.Volume = walker.volume
		walker.sound.PlaybackSpeed = math.clamp(speed / 16, 0.6, 1.4) * 0.92
	end
end

-- --------------------------------------------------------------- main loop

RunService.RenderStepped:Connect(function(dt)
	updateLighting(dt)
	updateRain(dt)
	updateFootsteps(dt)
end)
]]></ProtectedString>
			</Properties>
		</Item>
		<Item class="Script" referent="RBX11">
			<Properties>
				<string name="Name">BugServer</string>
				<token name="RunContext">1</token>
				<ProtectedString name="Source"><![CDATA[--[[
	Bug server: spawns bugs, moves them, hands out bug nets and decides what
	gets caught.

	Each bug is one invisible anchored Part in Workspace.Bugs, named after
	its bug Id. The server is the only one that moves it, so catches are
	checked against the real position. BugVisuals draws the actual bug
	on each player's screen and smooths its motion.

	Spawning:
	  Common bugs: any time.  Rare bugs: only at night.  Epic bugs: only in the rain.
	  Rare bugs leave when the sun comes up, and Epic bugs leave when the rain stops.

	Catching: a client only says "I swung". The server checks the swing rate,
	that the player is alive and holding the net, and which bugs are really
	inside the net's reach, so nobody can catch bugs from across the field.

	This is a Script with RunContext = Server, so it runs from ReplicatedStorage.
]]

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local StarterPack = game:GetService("StarterPack")
local Workspace = game:GetService("Workspace")

local folder = script.Parent
local Config = require(folder:WaitForChild("Config"))
local BugData = require(folder:WaitForChild("BugData"))
local BugBuilder = require(folder:WaitForChild("BugBuilder"))
local Environment = require(folder:WaitForChild("Environment"))
local Collection = require(folder:WaitForChild("Collection"))
local NetBuilder = require(folder:WaitForChild("NetBuilder"))
local Util = require(folder:WaitForChild("Util"))
local create = Util.create

local remote = folder:FindFirstChild("BugRemote") or create("RemoteEvent", { Name = "BugRemote", Parent = folder })

local oldFolder = Workspace:FindFirstChild("Bugs")
if oldFolder then
	oldFolder:Destroy()
end
local bugsFolder = create("Folder", { Name = "Bugs", Parent = Workspace })

local rng = Random.new()
local bugs = {} -- [anchor Part] = bug state
local counts = { Common = 0, Rare = 0, Epic = 0 }
local maxCounts = { Common = Config.MaxCommonBugs, Rare = Config.MaxRareBugs, Epic = Config.MaxEpicBugs }

local groundParams = RaycastParams.new()
groundParams.FilterType = Enum.RaycastFilterType.Include
groundParams.FilterDescendantsInstances = { Workspace.Terrain }

local function groundHeight(position)
	local result = Workspace:Raycast(position + Vector3.new(0, 30, 0), Vector3.new(0, -80, 0), groundParams)
	return result and result.Position.Y or 0
end

local function flat(v)
	return Vector3.new(v.X, 0, v.Z)
end

local function randomDirection()
	local angle = rng:NextNumber(0, math.pi * 2)
	return Vector3.new(math.cos(angle), 0, math.sin(angle))
end

local function randomFieldPoint(radius)
	return randomDirection() * math.sqrt(rng:NextNumber()) * radius
end

local function playerPositions()
	local positions = {}
	for _, player in Players:GetPlayers() do
		local character = player.Character
		local root = character and character:FindFirstChild("HumanoidRootPart")
		local humanoid = character and character:FindFirstChildOfClass("Humanoid")
		if root and humanoid and humanoid.Health > 0 then
			table.insert(positions, root.Position)
		end
	end
	return positions
end

local function pickWanderTarget(bug)
	local range = bug.flying and 30 or 16
	local target = flat(bug.position) + Vector3.new(rng:NextNumber(-range, range), 0, rng:NextNumber(-range, range))
	local limit = Config.FieldRadius * 0.92
	if target.Magnitude > limit then
		target = target.Unit * limit * rng:NextNumber(0.6, 1)
	end
	bug.target = target
end

local function spawnBug(info, positions)
	local point
	for _ = 1, 10 do
		local candidate = randomFieldPoint(Config.FieldRadius * 0.9)
		local clear = true
		for _, position in positions do
			if (flat(position) - candidate).Magnitude < Config.SpawnMinPlayerDistance then
				clear = false
				break
			end
		end
		if clear then
			point = candidate
			break
		end
	end
	if not point then
		return nil
	end

	local flying = info.Move == "Fly"
	local ground = groundHeight(point)
	local bug = {
		info = info,
		rarity = BugData.Rarities[info.Rarity],
		flying = flying,
		ground = ground,
		nextGroundCheck = 0,
		altitude = flying and rng:NextNumber(2.5, 4.8) or 0,
		lift = 0,
		phase = rng:NextNumber(0, math.pi * 2),
		heading = randomDirection(),
		speed = 0,
		pauseUntil = 0,
		fleeUntil = 0,
		fleeDirection = nil,
		leaveAt = nil,
		leaving = false,
		goneAt = 0,
	}
	bug.position = point + Vector3.new(0, ground + (flying and bug.altitude or BugBuilder.groundOffset(info)), 0)
	pickWanderTarget(bug)

	local anchor = create("Part", {
		Name = info.Id,
		Anchored = true,
		CanCollide = false,
		CanQuery = false,
		CanTouch = false,
		CastShadow = false,
		Transparency = 1,
		Size = Vector3.one * 0.4,
		CFrame = CFrame.lookAt(bug.position, bug.position + bug.heading),
	})
	anchor:SetAttribute("BugId", info.Id)
	anchor.Parent = bugsFolder
	bug.part = anchor
	bugs[anchor] = bug
	counts[info.Rarity] += 1
	return bug
end

-- Removes a bug. `caught` tells clients to play the catch effect instead of a fade.
local function removeBug(bug, caught)
	if bugs[bug.part] ~= bug then
		return
	end
	bugs[bug.part] = nil
	counts[bug.info.Rarity] -= 1
	if caught then
		bug.part:SetAttribute("Caught", true)
	end
	-- A short delay makes sure clients see the Caught flag before the part goes.
	task.delay(0.15, function()
		bug.part:Destroy()
	end)
end

local function steer(current, desired, rate, dt)
	local blended = current:Lerp(desired, math.min(1, rate * dt))
	if blended.Magnitude < 1e-3 then
		return desired
	end
	return blended.Unit
end

local function updateBug(bug, now, dt, positions)
	local info, rarity = bug.info, bug.rarity
	local here = flat(bug.position)

	-- Run from the nearest player who gets too close.
	local nearest, nearestDistance = nil, math.huge
	for _, position in positions do
		local distance = (flat(position) - here).Magnitude
		if distance < nearestDistance then
			nearest, nearestDistance = position, distance
		end
	end
	if nearest and nearestDistance < rarity.FleeRadius and not bug.leaving then
		local away = here - flat(nearest)
		bug.fleeDirection = away.Magnitude > 0.01 and away.Unit or bug.heading
		bug.fleeUntil = now + 1.2
		bug.pauseUntil = 0
	end

	local fleeing = now < bug.fleeUntil
	local desired, targetSpeed, turnRate
	if bug.leaving then
		desired, targetSpeed, turnRate = bug.heading, info.Speed, 2
	elseif fleeing then
		-- Zig-zag a little so bugs feel alive and are fun to chase.
		local wobble = math.sin(now * 3 + bug.phase) * 0.5
		desired, targetSpeed, turnRate = CFrame.Angles(0, wobble, 0) * bug.fleeDirection, rarity.FleeSpeed, 7
	elseif now < bug.pauseUntil then
		desired, targetSpeed, turnRate = bug.heading, 0, 2
	else
		local toTarget = bug.target - here
		if toTarget.Magnitude < 1.5 then
			pickWanderTarget(bug)
			if rng:NextNumber() < (bug.flying and 0.35 or 0.6) then
				bug.pauseUntil = now + rng:NextNumber(0.6, bug.flying and 1.6 or 3)
			end
			toTarget = bug.target - here
		end
		desired = toTarget.Magnitude > 0.01 and toTarget.Unit or bug.heading
		targetSpeed, turnRate = info.Speed, 3
	end

	-- Never leave the meadow (unless flying away for good).
	if here.Magnitude > Config.FieldRadius and not bug.leaving then
		desired, turnRate = -here.Unit, 6
	end

	bug.heading = steer(bug.heading, desired, turnRate, dt)
	bug.speed += (targetSpeed - bug.speed) * math.min(1, dt * 4)
	here += bug.heading * bug.speed * dt

	if now >= bug.nextGroundCheck then
		bug.ground = groundHeight(here + Vector3.new(0, bug.position.Y, 0))
		bug.nextGroundCheck = now + 0.25
	end

	local y
	if bug.flying then
		bug.lift += ((fleeing and 1 or 0) - bug.lift) * math.min(1, dt * 2)
		if bug.leaving then
			bug.altitude += dt * 5
		end
		y = bug.ground + bug.altitude + bug.lift + math.sin(now * 0.9 + bug.phase) * 0.8
	else
		y = bug.ground + BugBuilder.groundOffset(info)
	end
	bug.position = Vector3.new(here.X, y, here.Z)
	return CFrame.lookAt(bug.position, bug.position + bug.heading)
end

-- Rare bugs leave at sunrise and Epic bugs leave when the rain stops, a few at a time.
local function updateLeaving(now, night, raining)
	for _, bug in bugs do
		local rarity = bug.info.Rarity
		local belongs = (rarity ~= "Rare" or night) and (rarity ~= "Epic" or raining)
		if bug.leaving then
			if now >= bug.goneAt then
				removeBug(bug, false)
			end
		elseif not belongs then
			bug.leaveAt = bug.leaveAt or now + rng:NextNumber(0, 12)
			if now >= bug.leaveAt then
				bug.leaving = true
				bug.goneAt = now + (bug.flying and 4 or 0)
			end
		else
			bug.leaveAt = nil
		end
	end
end

local function trySpawn(rarity, chance, positions)
	if counts[rarity] < maxCounts[rarity] and rng:NextNumber() < chance then
		local options = BugData.ByRarity[rarity]
		spawnBug(options[rng:NextInteger(1, #options)], positions)
	end
end

local function spawnTick()
	local positions = playerPositions()
	trySpawn("Common", 1, positions)
	if Environment.isNight() then
		trySpawn("Rare", 0.6, positions)
	end
	if Environment.isRaining() then
		trySpawn("Epic", 0.6, positions)
	end
end

-- ------------------------------------------------------------------ the net

local netTemplate = NetBuilder.build(Config)
netTemplate.Parent = StarterPack -- copied into each player's backpack when they spawn

local lastSwing = {} -- [player] = os.clock() of their last accepted swing

-- Catches every bug inside the net's reach: a cylinder just in front of the player.
local function swingNet(player, root)
	if not root.Parent then
		return
	end
	local look = flat(root.CFrame.LookVector)
	if look.Magnitude < 0.01 then
		return
	end
	look = look.Unit
	local center = root.Position + look * Config.NetReach
	local netY = root.Position.Y - 1

	local caught = {}
	for _, bug in bugs do
		local sideways = (flat(bug.position) - flat(center)).Magnitude
		local inFront = flat(bug.position - root.Position):Dot(look) > -0.5
		if sideways <= Config.NetRadius and math.abs(bug.position.Y - netY) <= Config.NetHeight and inFront then
			table.insert(caught, bug)
		end
	end
	for _, bug in caught do
		removeBug(bug, true)
		local isNew, count = Collection.add(player, bug.info.Id)
		remote:FireClient(player, "Caught", bug.info.Id, isNew, count)
	end
end

remote.OnServerEvent:Connect(function(player, action)
	if action ~= "Swing" then
		return
	end
	local now = os.clock()
	if now - (lastSwing[player] or 0) < Config.SwingCooldown * 0.8 then
		return -- swinging faster than the net allows
	end
	local character = player.Character
	local tool = character and character:FindFirstChild(Config.NetName)
	local root = character and character:FindFirstChild("HumanoidRootPart")
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	if not (tool and tool:IsA("Tool") and root and humanoid and humanoid.Health > 0) then
		return
	end
	lastSwing[player] = now

	-- Everyone else sees the swing; the swinger already animated it.
	for _, other in Players:GetPlayers() do
		if other ~= player then
			remote:FireClient(other, "Swing", player)
		end
	end
	-- Check when the net comes down, a moment into the swing.
	task.delay(0.18, swingNet, player, root)
end)

local function onPlayerAdded(player)
	Collection.setup(player)
	local backpack = player:FindFirstChildOfClass("Backpack")
	if backpack and not backpack:FindFirstChild(Config.NetName) and not (player.Character and player.Character:FindFirstChild(Config.NetName)) then
		netTemplate:Clone().Parent = backpack
	end
end

Players.PlayerAdded:Connect(onPlayerAdded)
for _, player in Players:GetPlayers() do
	task.spawn(onPlayerAdded, player)
end
Players.PlayerRemoving:Connect(function(player)
	lastSwing[player] = nil
	Collection.remove(player)
end)

-- ------------------------------------------------------------------ main loop

-- Fill the meadow with common bugs right away.
for _ = 1, Config.MaxCommonBugs do
	trySpawn("Common", 1, {})
end

local spawnTimer = 0
local leaveTimer = 0
RunService.Heartbeat:Connect(function(dt)
	dt = math.min(dt, 0.1)
	local now = os.clock()

	spawnTimer -= dt
	if spawnTimer <= 0 then
		spawnTimer = Config.SpawnInterval
		spawnTick()
	end
	leaveTimer -= dt
	if leaveTimer <= 0 then
		leaveTimer = 0.5
		updateLeaving(now, Environment.isNight(), Environment.isRaining())
	end

	local positions = playerPositions()
	local parts, cframes = {}, {}
	for part, bug in bugs do
		table.insert(parts, part)
		table.insert(cframes, updateBug(bug, now, dt, positions))
	end
	if #parts > 0 then
		Workspace:BulkMoveTo(parts, cframes, Enum.BulkMoveMode.FireCFrameChanged)
	end
end)
]]></ProtectedString>
			</Properties>
		</Item>
		<Item class="Script" referent="RBX12">
			<Properties>
				<string name="Name">BugVisuals</string>
				<token name="RunContext">2</token>
				<ProtectedString name="Source"><![CDATA[--[[
	Bug visuals: draws every bug on this player's screen.

	The server moves one invisible part per bug (Workspace.Bugs). Here each
	part gets a full bug model that glides after it, so motion stays smooth
	even though the server only sends positions over the network. On top of
	that: wing flaps, scuttling legs, hops, worm wiggles, banking turns,
	pulsing glow for rare bugs, and a sparkle burst when a bug is caught.

	This is a Script with RunContext = Client, so it runs from ReplicatedStorage.
]]

local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")
local Workspace = game:GetService("Workspace")

local folder = script.Parent
local BugData = require(folder:WaitForChild("BugData"))
local BugBuilder = require(folder:WaitForChild("BugBuilder"))
local Util = require(folder:WaitForChild("Util"))
local create, smooth = Util.create, Util.smooth

local bugsFolder = Workspace:WaitForChild("Bugs")
local visualFolder = create("Folder", { Name = "BugVisuals", Parent = Workspace })

local DRAW_DISTANCE = 420 -- the whole meadow; farther bugs freeze in place

-- How each body plan flaps: frequency (flaps per second), amplitude and resting angle (radians).
local FLAP = {
	Butterfly = { freq = 3.2, amp = 0.62, bias = 0.38 },
	Bee = { freq = 17, amp = 0.5, bias = 0.25 },
	Dragonfly = { freq = 11, amp = 0.32, bias = 0.05 },
}

local visuals = {} -- [anchor Part] = visual

local function addBug(anchor)
	if not anchor:IsA("BasePart") or visuals[anchor] then
		return
	end
	local bug = BugData.ById[anchor:GetAttribute("BugId") or anchor.Name]
	if not bug then
		return
	end
	local rig = BugBuilder.build(bug, { effects = true })
	rig.model:PivotTo(anchor.CFrame) -- so it never flashes at the world origin
	rig.model.Parent = visualFolder
	visuals[anchor] = {
		anchor = anchor,
		bug = bug,
		rig = rig,
		cframe = anchor.CFrame,
		lastTarget = anchor.CFrame,
		lastUpdate = os.clock(),
		speed = 0,
		smoothSpeed = 0,
		turn = 0,
		roll = 0,
		stride = 0,
		phase = math.random() * math.pi * 2,
		baseLight = rig.light and rig.light.Brightness or 0,
	}
end

local function sparkleBurst(position, color)
	local holder = create("Part", {
		Anchored = true,
		CanCollide = false,
		CanQuery = false,
		CanTouch = false,
		Transparency = 1,
		Size = Vector3.one * 0.2,
		CFrame = CFrame.new(position),
		Parent = visualFolder,
	})
	local emitter = create("ParticleEmitter", {
		Enabled = false,
		Lifetime = NumberRange.new(0.5, 0.9),
		Speed = NumberRange.new(5, 11),
		SpreadAngle = Vector2.new(180, 180),
		Drag = 4,
		Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.45), NumberSequenceKeypoint.new(1, 0) }),
		Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0), NumberSequenceKeypoint.new(1, 1) }),
		Color = ColorSequence.new(color, Color3.new(1, 1, 1)),
		LightEmission = 1,
		Parent = holder,
	})
	emitter:Emit(26)
	task.delay(1.2, function()
		holder:Destroy()
	end)
end

local function removeBug(anchor)
	local visual = visuals[anchor]
	if not visual then
		return
	end
	visuals[anchor] = nil
	local model = visual.rig.model
	if anchor:GetAttribute("Caught") then
		sparkleBurst(visual.cframe.Position, BugData.Rarities[visual.bug.Rarity].Color)
		model:Destroy()
		return
	end
	-- Flew off or wandered out of range: fade away.
	local info = TweenInfo.new(0.4)
	for _, record in visual.rig.parts do
		TweenService:Create(record.part, info, { Transparency = 1 }):Play()
	end
	if visual.rig.light then
		TweenService:Create(visual.rig.light, info, { Brightness = 0 }):Play()
	end
	task.delay(0.45, function()
		model:Destroy()
	end)
end

bugsFolder.ChildAdded:Connect(addBug)
bugsFolder.ChildRemoved:Connect(removeBug)
for _, anchor in bugsFolder:GetChildren() do
	addBug(anchor)
end

local function animate(visual, t, dt, parts, cframes)
	local bug, rig = visual.bug, visual.rig
	local s = rig.scale
	local target = visual.anchor.CFrame

	-- How fast the server is moving and turning this bug. Updates arrive less
	-- often than frames, so measure over the time between updates.
	local moved = (target.Position - visual.lastTarget.Position).Magnitude
	if moved > 0 then
		local elapsed = math.clamp(t - visual.lastUpdate, 1 / 120, 0.5)
		local turn = visual.lastTarget.LookVector:Cross(target.LookVector).Y / elapsed
		visual.speed = moved / elapsed
		visual.turn = turn
		visual.lastTarget = target
		visual.lastUpdate = t
	elseif t - visual.lastUpdate > 0.25 then
		visual.speed, visual.turn = 0, 0
	end
	visual.smoothSpeed += (visual.speed - visual.smoothSpeed) * smooth(6, dt)
	-- Lean into turns.
	visual.roll += (math.clamp(-visual.turn * 0.12, -0.6, 0.6) - visual.roll) * smooth(6, dt)

	-- Glide after the server position.
	if (visual.cframe.Position - target.Position).Magnitude > 20 then
		visual.cframe = target -- too far behind (just streamed in): snap
	else
		visual.cframe = visual.cframe:Lerp(target, smooth(10, dt))
	end

	local speed = visual.smoothSpeed
	local root
	if bug.Move == "Fly" then
		local bob = math.sin(t * 2.4 + visual.phase) * 0.22 * s
		local pitch = -math.min(speed / 25, 0.3)
		root = visual.cframe * CFrame.new(0, bob, 0) * CFrame.Angles(pitch, 0, visual.roll)
	else
		visual.stride += dt * (speed / s) * 3
		local hop = 0
		if bug.Shape == "Hopper" and speed > 1 then
			hop = math.abs(math.sin(visual.stride * 0.9)) * 0.9 * s
		end
		root = visual.cframe * CFrame.new(0, hop, 0)
	end

	local flap = FLAP[bug.Shape]
	local flapRate = flap and flap.freq * (1 + math.min(speed / 12, 0.6)) or 0
	for _, record in rig.parts do
		local kind = record.kind
		local cf
		if kind == "wing" then
			local angle = flap.bias + math.sin(t * flapRate * math.pi * 2 + record.phase + visual.phase) * flap.amp
			cf = root * record.hinge * CFrame.Angles(0, 0, record.side * angle) * record.rel
		elseif kind == "leg" then
			local swing = bug.Move == "Crawl" and math.sin(visual.stride * 4 + record.phase) * 0.45 * math.min(speed, 1)
				or math.sin(t * 2 + record.phase) * 0.08
			cf = root * record.hinge * CFrame.Angles(0, swing, 0) * record.rel
		elseif kind == "antenna" then
			local twitch = math.sin(t * 3.1 + record.phase * 1.7 + visual.phase) * 0.12
			cf = root * record.hinge * CFrame.Angles(twitch, 0, 0) * record.rel
		elseif kind == "segment" then
			local wave = visual.stride * 2.2 - record.index * 0.9
			cf = root * CFrame.new(math.sin(wave) * 0.07 * s, math.max(0, math.sin(wave)) * 0.04 * s, 0) * record.rel
		else
			cf = root * record.rel
		end
		table.insert(parts, record.part)
		table.insert(cframes, cf)
	end

	if rig.light then
		rig.light.Brightness = visual.baseLight * (0.7 + 0.3 * math.sin(t * 2.6 + visual.phase))
	end
	for _, part in rig.rainbow do
		part.Color = Color3.fromHSV((t * 0.12 + visual.phase / 6) % 1, 0.65, 1)
	end
end

RunService.RenderStepped:Connect(function(dt)
	local camera = Workspace.CurrentCamera
	local cameraPosition = camera and camera.CFrame.Position or Vector3.zero
	local t = os.clock()
	local parts, cframes = {}, {}
	for _, visual in visuals do
		if (visual.anchor.Position - cameraPosition).Magnitude < DRAW_DISTANCE then
			animate(visual, t, dt, parts, cframes)
		end
	end
	if #parts > 0 then
		Workspace:BulkMoveTo(parts, cframes, Enum.BulkMoveMode.FireCFrameChanged)
	end
end)
]]></ProtectedString>
			</Properties>
		</Item>
		<Item class="Script" referent="RBX13">
			<Properties>
				<string name="Name">NetClient</string>
				<token name="RunContext">2</token>
				<ProtectedString name="Source"><![CDATA[--[[
	Net client: swinging the bug net.

	Click (PC), tap (mobile) or press the trigger (gamepad) while holding the
	net. The swing plays right away on your screen, then the server checks
	what you caught. Other players' swings are animated here too, and
	catches play a sound.

	The swing moves the right shoulder joint locally, so it works on R15 and
	R6 characters without any uploaded animations.

	This is a Script with RunContext = Client, so it runs from ReplicatedStorage.
]]

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local SoundService = game:GetService("SoundService")

local folder = script.Parent
local Config = require(folder:WaitForChild("Config"))
local Util = require(folder:WaitForChild("Util"))
local remote = folder:WaitForChild("BugRemote")

local player = Players.LocalPlayer

local SWING_TIME = 0.5

-- Shoulder angle (radians, + raises the arm) over the swing: wind up, sweep down, recover.
local function swingAngle(t)
	if t < 0.1 then
		local a = t / 0.1
		return 0.8 * (1 - (1 - a) ^ 2)
	elseif t < 0.24 then
		local a = (t - 0.1) / 0.14
		local eased = a < 0.5 and 2 * a * a or 1 - (-2 * a + 2) ^ 2 / 2
		return 0.8 - 1.95 * eased
	end
	local a = math.min((t - 0.24) / (SWING_TIME - 0.24), 1)
	return -1.15 * (1 - a) ^ 2
end

local swings = {} -- [character] = { motor, baseC0, axis, started, trail }

local function findShoulder(character)
	local arm = character:FindFirstChild("RightUpperArm")
	local motor = arm and arm:FindFirstChild("RightShoulder")
	if not motor then
		local torso = character:FindFirstChild("Torso")
		motor = torso and torso:FindFirstChild("Right Shoulder")
	end
	return motor and motor:IsA("Motor6D") and motor or nil
end

local function playSwing(character)
	local tool = character:FindFirstChild(Config.NetName)
	local motor = findShoulder(character)
	if not tool or not motor then
		return
	end
	local handle = tool:FindFirstChild("Handle")
	local existing = swings[character]
	local baseC0 = existing and existing.baseC0 or motor.C0
	-- Pitch around the torso's sideways axis, expressed in the joint's own frame.
	local axis = baseC0.Rotation:VectorToObjectSpace(Vector3.xAxis)
	local trail = handle and handle:FindFirstChild("SwingTrail")
	swings[character] = { motor = motor, baseC0 = baseC0, axis = axis, started = os.clock(), trail = trail }

	local sound = handle and handle:FindFirstChild("SwingSound")
	if sound and sound:IsA("Sound") then
		sound.PlaybackSpeed = 1.15 + math.random() * 0.2
		sound:Play()
	end
end

RunService.RenderStepped:Connect(function()
	local now = os.clock()
	for character, swing in swings do
		local t = now - swing.started
		if t >= SWING_TIME or not swing.motor.Parent then
			swing.motor.C0 = swing.baseC0
			if swing.trail then
				swing.trail.Enabled = false
			end
			swings[character] = nil
		else
			swing.motor.C0 = swing.baseC0 * CFrame.fromAxisAngle(swing.axis, swingAngle(t))
			if swing.trail then
				swing.trail.Enabled = t > 0.08 and t < 0.3
			end
		end
	end
end)

-- ------------------------------------------------------------------ your own net

local lastSwing = 0

local function hookTool(tool)
	if not tool:IsA("Tool") or tool.Name ~= Config.NetName or tool:GetAttribute("Hooked") then
		return
	end
	tool:SetAttribute("Hooked", true)
	tool.Activated:Connect(function()
		local now = os.clock()
		local character = player.Character
		if now - lastSwing < Config.SwingCooldown or not character or tool.Parent ~= character then
			return
		end
		lastSwing = now
		playSwing(character)
		remote:FireServer("Swing")
	end)
end

local function onCharacter(character)
	character.ChildAdded:Connect(hookTool)
	for _, child in character:GetChildren() do
		hookTool(child)
	end
	-- Equip the net straight away so players can start catching.
	task.defer(function()
		local backpack = player:WaitForChild("Backpack", 10)
		local net = backpack and backpack:WaitForChild(Config.NetName, 10)
		local humanoid = character:FindFirstChildOfClass("Humanoid")
		if net and humanoid and not character:FindFirstChildOfClass("Tool") and net.Parent == backpack then
			humanoid:EquipTool(net)
		end
	end)
end

player.CharacterAdded:Connect(onCharacter)
if player.Character then
	onCharacter(player.Character)
end

-- ------------------------------------------------------------------ server messages

remote.OnClientEvent:Connect(function(action, ...)
	if action == "Swing" then
		local swinger = ...
		if typeof(swinger) == "Instance" and swinger ~= player and swinger.Character then
			playSwing(swinger.Character)
		end
	elseif action == "Caught" then
		local _, isNew = ...
		Util.playSound(Config.Sounds.Catch, SoundService, 0.7, isNew and 1 or 1.15)
		if isNew then
			Util.playSound(Config.Sounds.NewBug, SoundService, 0.5)
		end
	end
end)
