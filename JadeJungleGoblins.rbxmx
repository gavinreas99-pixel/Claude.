<roblox xmlns:xmime="http://www.w3.org/2005/05/xmlmime" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://www.roblox.com/roblox.xsd" version="4">
	<Item class="Folder" referent="RBX0">
		<Properties><string name="Name">JadeJungleGoblins</string></Properties>
		<Item class="ModuleScript" referent="RBX1">
			<Properties>
				<string name="Name">Config</string>
				<ProtectedString name="Source"><![CDATA[--[[
	Jade Jungle goblin settings. Tweak these numbers to tune the goblins.

	Spawn points: make a Folder at Workspace > JadeJungle > GoblinSpawns and
	put a few anchored, invisible Parts in it. One goblin lives at each Part.
	If that folder doesn't exist, goblins spawn around FallbackCenter instead.
]]

return {
	-- Where the spawn-point Parts live, as a path from Workspace.
	SpawnFolderPath = { "JadeJungle", "GoblinSpawns" },

	-- Used only when the spawn folder above is missing.
	FallbackCenter = Vector3.new(0, 10, 0),
	FallbackRadius = 40,
	FallbackCount = 6,

	GoblinsPerSpawn = 1,
	MaxGoblins = 12,
	RespawnTime = 20, -- seconds after death before a goblin returns
	CorpseTime = 6, -- seconds the ragdoll stays before disappearing

	-- 1 = about 4.6 studs tall (a little shorter than a player).
	Scale = 1.1,

	MaxHealth = 100,
	WanderSpeed = 7,
	ChaseSpeed = 15,
	WanderRadius = 25, -- how far from its spawn a goblin wanders
	AggroRange = 45, -- how close a player must be to get chased
	LeashRange = 90, -- goblins give up once the player is this far from the spawn
	ThinkInterval = 0.15,

	AttackRange = 4.5,
	AttackDamage = 12,
	AttackCooldown = 1.4,
	AttackDuration = 0.65, -- length of the sword-swing animation

	-- Clients skip animating goblins farther away than this (performance).
	AnimateDistance = 300,

	Tag = "JadeGoblin",
}
]]></ProtectedString>
			</Properties>
		</Item>
		<Item class="ModuleScript" referent="RBX2">
			<Properties>
				<string name="Name">GoblinBuilder</string>
				<ProtectedString name="Source"><![CDATA[--[[
	GoblinBuilder

	Builds a rigged Jade Jungle goblin (big head, long ears, droopy nose,
	red tunic, leather belts, spiked round shield and curved scimitar) out
	of rounded parts, joined with Motor6Ds so GoblinAnimator can make it
	run, swing its sword and flinch.

	Layout while building: feet on y = 0, facing -Z (Roblox "forward").
	Every joint pivot is axis-aligned, so in GoblinAnimator:
	  +X rotation swings a limb forward, -X leans the body forward,
	  Z rotation raises an arm/ear sideways, Y rotation twists.

	Usage:
		local goblin = GoblinBuilder.build({ scale = 1.1 })
		goblin:PivotTo(CFrame.new(groundPosition))
		goblin.Parent = workspace
]]

local GoblinBuilder = {}

local PALETTE = {
	Skin = Color3.fromRGB(158, 180, 62),
	SkinDark = Color3.fromRGB(116, 136, 42),
	SkinLight = Color3.fromRGB(184, 198, 88),
	EarInner = Color3.fromRGB(212, 126, 72),
	EarTip = Color3.fromRGB(206, 150, 70),
	EyeWhite = Color3.fromRGB(236, 222, 176),
	Iris = Color3.fromRGB(226, 136, 28),
	Pupil = Color3.fromRGB(22, 14, 10),
	Mouth = Color3.fromRGB(64, 38, 28),
	Tunic = Color3.fromRGB(198, 72, 36),
	TunicDark = Color3.fromRGB(148, 48, 26),
	Leather = Color3.fromRGB(104, 64, 40),
	LeatherDark = Color3.fromRGB(64, 40, 28),
	Pants = Color3.fromRGB(92, 58, 38),
	Boot = Color3.fromRGB(128, 82, 50),
	Sole = Color3.fromRGB(52, 38, 30),
	Wood = Color3.fromRGB(124, 82, 46),
	WoodDark = Color3.fromRGB(70, 44, 26),
	Iron = Color3.fromRGB(150, 152, 158),
	IronDark = Color3.fromRGB(62, 64, 70),
	Blade = Color3.fromRGB(58, 60, 66),
	BladeEdge = Color3.fromRGB(150, 156, 164),
	Gold = Color3.fromRGB(214, 164, 52),
}

local SKIN_KEYS = { "Skin", "SkinDark", "SkinLight" }
local TUNIC_KEYS = { "Tunic", "TunicDark" }

-- Shifts a group of colours together so each goblin looks a bit different.
local function shiftColors(colors, keys, hue, value)
	for _, key in keys do
		local h, s, v = colors[key]:ToHSV()
		colors[key] = Color3.fromHSV((h + hue) % 1, s, math.clamp(v + value, 0, 1))
	end
end

function GoblinBuilder.build(options)
	options = options or {}
	local S = options.scale or 1
	local rng = options.random or Random.new()

	local C = table.clone(PALETTE)
	shiftColors(C, SKIN_KEYS, rng:NextNumber(-0.035, 0.035), rng:NextNumber(-0.06, 0.04))
	shiftColors(C, TUNIC_KEYS, rng:NextNumber(-0.03, 0.03), rng:NextNumber(-0.08, 0.04))

	local M = Enum.Material
	local model = Instance.new("Model")
	model.Name = options.name or "Jade Goblin"
	model:SetAttribute("Scale", S)

	-- A CFrame at a position given in unscaled goblin units.
	local function at(x, y, z)
		return CFrame.new(x * S, y * S, z * S)
	end

	local function newPart(kind, name, size, cf, color, material)
		local part
		if kind == "wedge" then
			part = Instance.new("WedgePart")
		else
			part = Instance.new("Part")
			if kind == "cyl" then
				part.Shape = Enum.PartType.Cylinder
			end
		end
		part.Name = name
		part.Size = size * S
		part.CFrame = cf
		part.Color = color
		part.Material = material or M.SmoothPlastic
		part.Anchored = false
		part.CanCollide = false
		part.Massless = true
		part.TopSurface = Enum.SurfaceType.Smooth
		part.BottomSurface = Enum.SurfaceType.Smooth
		if kind == "ball" then
			-- A sphere mesh stretched to the part size gives smooth ellipsoids.
			local mesh = Instance.new("SpecialMesh")
			mesh.MeshType = Enum.MeshType.Sphere
			mesh.Parent = part
		end
		-- Parts sit directly in the model so weapon scripts that check
		-- hit.Parent:FindFirstChildOfClass("Humanoid") still hit the goblin.
		part.Parent = model
		return part
	end

	-- Decoration welded onto a body segment.
	local function deco(segment, kind, name, size, cf, color, material)
		local part = newPart(kind, name, size, cf, color, material)
		local weld = Instance.new("Weld")
		weld.Part0 = segment
		weld.Part1 = part
		weld.C0 = segment.CFrame:ToObjectSpace(cf)
		weld.Parent = part
		return part
	end

	local function joint(name, part0, part1, pivot)
		local motor = Instance.new("Motor6D")
		motor.Name = name
		motor.Part0 = part0
		motor.Part1 = part1
		motor.C0 = part0.CFrame:ToObjectSpace(pivot)
		motor.C1 = part1.CFrame:ToObjectSpace(pivot)
		motor.Parent = part1
		return motor
	end

	-- A cone made of stacked, shrinking cylinders. baseCF looks along the spike.
	local function cone(segment, name, baseCF, length, diameter, color, material, steps)
		steps = steps or 5
		local step = length / steps
		for i = 0, steps - 1 do
			local d = diameter * (1 - i / steps)
			local cf = baseCF * at(0, 0, -(i + 0.5) * step) * CFrame.Angles(0, math.pi / 2, 0)
			deco(segment, "cyl", name, Vector3.new(step * 1.02, d, d), cf, color, material)
		end
	end

	local vertical = CFrame.Angles(0, 0, math.pi / 2) -- cylinder axis X -> Y
	local alongZ = CFrame.Angles(0, math.pi / 2, 0) -- cylinder axis X -> -Z

	--------------------------------------------------------------------------
	-- Root
	--------------------------------------------------------------------------
	local root = newPart("block", "HumanoidRootPart", Vector3.new(1.6, 1.8, 1), at(0, 2, 0), Color3.new(), nil)
	root.Transparency = 1
	root.CanCollide = true
	root.Massless = false
	root.RootPriority = 127
	root.PivotOffset = CFrame.new(0, -2 * S, 0) -- model pivot sits at the feet
	model.PrimaryPart = root

	--------------------------------------------------------------------------
	-- Hips: tunic skirt, belts, loincloth flaps
	--------------------------------------------------------------------------
	local lowerTorso = newPart("ball", "LowerTorso", Vector3.new(1.5, 0.85, 1.1), at(0, 1.85, 0), C.Tunic, M.Fabric)
	joint("Root", root, lowerTorso, at(0, 1.85, 0))

	deco(lowerTorso, "ball", "Belt", Vector3.new(1.62, 0.26, 1.2), at(0, 2.02, 0), C.Leather, M.Leather)
	deco(lowerTorso, "ball", "Belt", Vector3.new(1.58, 0.22, 1.16), at(0, 1.8, 0) * CFrame.Angles(0, 0, 0.1), C.LeatherDark, M.Leather)
	-- Square iron buckles: an iron plate with a dark leather "hole" in it.
	deco(lowerTorso, "block", "Buckle", Vector3.new(0.3, 0.26, 0.06), at(-0.12, 2.02, -0.62), C.Iron, M.Metal)
	deco(lowerTorso, "block", "Buckle", Vector3.new(0.16, 0.12, 0.07), at(-0.12, 2.02, -0.625), C.LeatherDark, M.Leather)
	deco(lowerTorso, "block", "Buckle", Vector3.new(0.26, 0.22, 0.06), at(0.3, 1.8, -0.6) * CFrame.Angles(0, 0, 0.1), C.Iron, M.Metal)
	deco(lowerTorso, "block", "Buckle", Vector3.new(0.14, 0.1, 0.07), at(0.3, 1.8, -0.605) * CFrame.Angles(0, 0, 0.1), C.LeatherDark, M.Leather)

	local frontFlap = newPart("block", "FrontFlap", Vector3.new(0.66, 0.64, 0.07), at(0, 1.4, -0.5), C.Tunic, M.Fabric)
	deco(frontFlap, "block", "Hem", Vector3.new(0.66, 0.09, 0.08), at(0, 1.13, -0.5), C.TunicDark, M.Fabric)
	deco(frontFlap, "wedge", "Hem", Vector3.new(0.08, 0.14, 0.3), at(-0.18, 1.02, -0.5) * CFrame.Angles(0, math.pi / 2, math.pi), C.TunicDark, M.Fabric)
	deco(frontFlap, "wedge", "Hem", Vector3.new(0.08, 0.14, 0.3), at(0.16, 1.02, -0.5) * CFrame.Angles(0, -math.pi / 2, math.pi), C.TunicDark, M.Fabric)
	joint("FrontFlap", lowerTorso, frontFlap, at(0, 1.72, -0.5))

	local backFlap = newPart("block", "BackFlap", Vector3.new(0.8, 0.7, 0.07), at(0, 1.37, 0.5), C.Tunic, M.Fabric)
	deco(backFlap, "block", "Hem", Vector3.new(0.8, 0.09, 0.08), at(0, 1.07, 0.5), C.TunicDark, M.Fabric)
	joint("BackFlap", lowerTorso, backFlap, at(0, 1.72, 0.5))

	--------------------------------------------------------------------------
	-- Chest
	--------------------------------------------------------------------------
	local upperTorso = newPart("ball", "UpperTorso", Vector3.new(1.45, 1.25, 1.02), at(0, 2.6, 0.02), C.Tunic, M.Fabric)
	joint("Waist", lowerTorso, upperTorso, at(0, 2.05, 0))

	-- Diagonal leather strap from the left shoulder down to the right hip.
	deco(upperTorso, "ball", "ChestStrap", Vector3.new(0.3, 1.6, 1.1), at(0, 2.55, 0.02) * CFrame.Angles(0, 0, 0.7), C.Leather, M.Leather)
	deco(upperTorso, "block", "StrapBuckle", Vector3.new(0.26, 0.26, 0.06), at(0.02, 2.5, -0.55) * CFrame.Angles(0, 0, 0.7), C.Iron, M.Metal)
	deco(upperTorso, "block", "StrapBuckle", Vector3.new(0.13, 0.13, 0.07), at(0.02, 2.5, -0.555) * CFrame.Angles(0, 0, 0.7), C.LeatherDark, M.Leather)
	deco(upperTorso, "ball", "Collar", Vector3.new(1.0, 0.25, 0.8), at(0, 3.0, 0.02), C.TunicDark, M.Fabric)
	deco(upperTorso, "ball", "Neck", Vector3.new(0.7, 0.5, 0.65), at(0, 3.05, -0.02), C.Skin)
	-- Wooden board slung across the back, peeking over the left shoulder.
	deco(upperTorso, "block", "BackBoard", Vector3.new(0.55, 1.3, 0.18), at(-0.35, 3.0, 0.6) * CFrame.Angles(0.15, 0, 0.45), C.Wood, M.Wood)
	deco(upperTorso, "block", "BackBoard", Vector3.new(0.05, 1.28, 0.19), at(-0.35, 3.0, 0.6) * CFrame.Angles(0.15, 0, 0.45) * at(0.1, 0, 0), C.WoodDark, M.Wood)

	--------------------------------------------------------------------------
	-- Head
	--------------------------------------------------------------------------
	local head = newPart("ball", "Head", Vector3.new(1.75, 1.65, 1.6), at(0, 3.78, -0.05), C.Skin)
	joint("Neck", upperTorso, head, at(0, 3.0, 0))

	deco(head, "ball", "Jaw", Vector3.new(1.45, 1.0, 1.35), at(0, 3.25, -0.2), C.Skin)
	deco(head, "ball", "Chin", Vector3.new(0.6, 0.36, 0.45), at(0, 2.78, -0.48), C.Skin)
	deco(head, "ball", "Mouth", Vector3.new(0.6, 0.07, 0.08), at(0, 2.93, -0.715), C.Mouth)
	for _, side in { -1, 1 } do
		-- Down-turned corners of the mouth give the grumpy frown.
		deco(head, "ball", "Mouth", Vector3.new(0.18, 0.06, 0.07), at(side * 0.31, 2.89, -0.66) * CFrame.Angles(0, 0, side * 0.5), C.Mouth)
		deco(head, "ball", "Cheek", Vector3.new(0.5, 0.42, 0.42), at(side * 0.45, 3.4, -0.58), C.SkinLight)
		-- Heavy, angry brows that slope down toward the nose.
		deco(head, "ball", "Brow", Vector3.new(0.66, 0.26, 0.42), at(side * 0.32, 4.0, -0.68) * CFrame.Angles(0, 0, side * 0.28), C.SkinDark)
		-- Eye: white, orange iris, pupil, then a half-closed lid and an under-eye bag.
		deco(head, "ball", "EyeWhite", Vector3.new(0.34, 0.26, 0.2), at(side * 0.33, 3.78, -0.78), C.EyeWhite)
		deco(head, "ball", "Iris", Vector3.new(0.17, 0.17, 0.17), at(side * 0.31, 3.76, -0.86), C.Iris)
		deco(head, "ball", "Pupil", Vector3.new(0.08, 0.08, 0.06), at(side * 0.31, 3.76, -0.925), C.Pupil, M.Glass)
		deco(head, "ball", "Eyelid", Vector3.new(0.4, 0.16, 0.28), at(side * 0.33, 3.9, -0.8), C.Skin)
		deco(head, "ball", "EyeBag", Vector3.new(0.36, 0.1, 0.18), at(side * 0.33, 3.63, -0.77), C.SkinDark)
		deco(head, "ball", "Nostril", Vector3.new(0.12, 0.08, 0.1), at(side * 0.11, 3.0, -1.12), C.Mouth)
	end
	deco(head, "ball", "Nose", Vector3.new(0.42, 0.95, 0.55), at(0, 3.5, -0.92) * CFrame.Angles(0.35, 0, 0), C.SkinLight)
	deco(head, "ball", "NoseTip", Vector3.new(0.5, 0.44, 0.5), at(0, 3.18, -1.1), C.SkinLight)
	deco(head, "ball", "Wrinkle", Vector3.new(0.7, 0.045, 0.08), at(0, 4.2, -0.72), C.SkinDark)
	deco(head, "ball", "Wrinkle", Vector3.new(0.56, 0.045, 0.08), at(0, 4.3, -0.66), C.SkinDark)

	-- Long ears that sweep up and back. Each one is jointed so it can flop.
	for _, side in { -1, 1 } do
		local prefix = side < 0 and "Left" or "Right"
		local pivot = at(side * 0.8, 3.85, 0.05)
		local earCF = pivot * CFrame.Angles(0, -side * 0.35, side * 0.38) * at(side * 0.82, 0, 0)
		local ear = newPart("ball", prefix .. "Ear", Vector3.new(1.75, 0.6, 0.16), earCF, C.Skin)
		deco(ear, "ball", "EarInner", Vector3.new(1.3, 0.4, 0.06), earCF * at(side * 0.08, -0.02, -0.06), C.EarInner)
		deco(ear, "ball", "EarTip", Vector3.new(0.6, 0.36, 0.17), earCF * at(side * 0.6, 0.01, 0), C.EarTip)
		joint(prefix .. "Ear", head, ear, pivot)
	end

	--------------------------------------------------------------------------
	-- Arms (left = -X holds the scimitar, right = +X holds the shield)
	--------------------------------------------------------------------------
	local lowerArms = {}
	for _, side in { -1, 1 } do
		local prefix = side < 0 and "Left" or "Right"
		local upperArm = newPart("ball", prefix .. "UpperArm", Vector3.new(0.44, 0.9, 0.44), at(side * 0.9, 2.42, 0), C.Skin)
		joint(prefix .. "Shoulder", upperTorso, upperArm, at(side * 0.78, 2.85, 0))
		deco(upperArm, "ball", "Sleeve", Vector3.new(0.58, 0.52, 0.58), at(side * 0.86, 2.72, 0), C.Tunic, M.Fabric)
		deco(upperArm, "ball", "SleeveHem", Vector3.new(0.6, 0.1, 0.6), at(side * 0.87, 2.5, 0), C.TunicDark, M.Fabric)

		local lowerArm = newPart("ball", prefix .. "LowerArm", Vector3.new(0.4, 0.82, 0.4), at(side * 0.95, 1.66, 0), C.Skin)
		joint(prefix .. "Elbow", upperArm, lowerArm, at(side * 0.93, 2.02, 0))
		lowerArms[side] = lowerArm

		-- Clenched fist: palm, knuckles and thumb.
		deco(lowerArm, "ball", "Fist", Vector3.new(0.46, 0.44, 0.46), at(side * 0.97, 1.16, -0.02), C.Skin)
		deco(lowerArm, "ball", "Knuckles", Vector3.new(0.36, 0.22, 0.3), at(side * 0.97, 1.12, -0.2), C.SkinLight)
		deco(lowerArm, "ball", "Thumb", Vector3.new(0.16, 0.3, 0.16), at(side * 0.84, 1.22, -0.18), C.Skin)
	end

	-- Left shoulder: iron pauldron.
	local leftUpperArm = model:FindFirstChild("LeftUpperArm")
	deco(leftUpperArm, "ball", "Pauldron", Vector3.new(0.72, 0.42, 0.78), at(-0.88, 2.95, 0), C.Iron, M.Metal)
	deco(leftUpperArm, "ball", "Pauldron", Vector3.new(0.8, 0.12, 0.84), at(-0.9, 2.82, 0), C.IronDark, M.Metal)

	-- Left forearm: spiked leather bracer.
	local leftArm = lowerArms[-1]
	deco(leftArm, "cyl", "Bracer", Vector3.new(0.5, 0.52, 0.52), at(-0.95, 1.6, 0) * vertical, C.LeatherDark, M.Leather)
	deco(leftArm, "cyl", "BracerBand", Vector3.new(0.07, 0.56, 0.56), at(-0.95, 1.84, 0) * vertical, C.Iron, M.Metal)
	deco(leftArm, "cyl", "BracerBand", Vector3.new(0.07, 0.56, 0.56), at(-0.95, 1.37, 0) * vertical, C.Iron, M.Metal)
	for i = 0, 5 do
		local a = i / 6 * math.pi * 2
		local dir = Vector3.new(math.cos(a), 0, math.sin(a))
		local base = at(-0.95, i % 2 == 0 and 1.68 or 1.52, 0).Position + dir * 0.24 * S
		cone(leftArm, "BracerSpike", CFrame.lookAt(base, base + dir), 0.26, 0.14, C.Iron, M.Metal, 4)
	end

	-- Scimitar held in the left fist. At rest the blade points forward, so
	-- bending the elbow swings it up.
	local hand = Vector3.new(-0.97, 1.16, -0.02)
	deco(leftArm, "cyl", "SwordGrip", Vector3.new(0.75, 0.16, 0.16), at(hand.X, hand.Y, hand.Z) * alongZ, C.LeatherDark, M.Leather)
	deco(leftArm, "cyl", "SwordPommel", Vector3.new(0.14, 0.24, 0.24), at(hand.X, hand.Y, 0.4) * alongZ, C.IronDark, M.Metal)
	deco(leftArm, "block", "SwordGuard", Vector3.new(0.14, 0.56, 0.16), at(hand.X, hand.Y, -0.42), C.Gold, M.Metal)
	deco(leftArm, "ball", "SwordGuard", Vector3.new(0.16, 0.16, 0.2), at(hand.X, hand.Y + 0.3, -0.44), C.Gold, M.Metal)
	deco(leftArm, "ball", "SwordGuard", Vector3.new(0.16, 0.16, 0.2), at(hand.X, hand.Y - 0.3, -0.44), C.Gold, M.Metal)
	local widths = { 0.26, 0.29, 0.33, 0.36, 0.38, 0.36 }
	local spine = 0.13 -- straight back edge; the blade widens toward the cutting edge
	local cur = at(hand.X, hand.Y, -0.5)
	for _, w in widths do
		local len = 0.34
		deco(leftArm, "block", "Blade", Vector3.new(0.06, w, len + 0.02), cur * at(0, spine - w / 2, -len / 2), C.Blade, M.Metal)
		deco(leftArm, "block", "BladeEdge", Vector3.new(0.065, 0.06, len + 0.02), cur * at(0, spine - w + 0.03, -len / 2), C.BladeEdge, M.Metal)
		cur = cur * at(0, 0, -len) * CFrame.Angles(0.09, 0, 0) -- curve upward
	end
	deco(leftArm, "wedge", "BladeTip", Vector3.new(0.06, 0.34, 0.5), cur * at(0, spine - 0.17, -0.25) * CFrame.Angles(0, 0, math.pi), C.Blade, M.Metal)

	-- Round wooden shield with an iron rim and centre spike, on the right forearm.
	local rightArm = lowerArms[1]
	deco(rightArm, "cyl", "ShieldStrap", Vector3.new(0.25, 0.46, 0.46), at(0.95, 1.55, 0) * vertical, C.LeatherDark, M.Leather)
	local shield = at(1.28, 1.6, -0.12) * CFrame.Angles(0, 0.95, 0) -- local +X = shield face
	deco(rightArm, "cyl", "ShieldWood", Vector3.new(0.14, 1.75, 1.75), shield, C.Wood, M.Wood)
	deco(rightArm, "cyl", "ShieldBack", Vector3.new(0.08, 1.92, 1.92), shield * at(-0.06, 0, 0), C.IronDark, M.Metal)
	for _, z in { -0.6, -0.3, 0, 0.3, 0.6 } do
		local chord = 2 * math.sqrt(0.875 ^ 2 - z ^ 2) * 0.98
		deco(rightArm, "block", "ShieldPlank", Vector3.new(0.02, chord, 0.035), shield * at(0.07, 0, z), C.WoodDark, M.Wood)
	end
	local rimPieces = 22
	for i = 0, rimPieces - 1 do
		local a = i / rimPieces * math.pi * 2
		local spin = shield * CFrame.Angles(a, 0, 0)
		deco(rightArm, "block", "ShieldRim", Vector3.new(0.24, 0.2, 2 * math.pi * 0.9 / rimPieces * 1.08), spin * at(0.02, 0.9, 0), C.Iron, M.Metal)
		if i % 2 == 0 then
			deco(rightArm, "ball", "Rivet", Vector3.new(0.1, 0.1, 0.1), spin * at(0.15, 0.9, 0), C.IronDark, M.Metal)
		end
	end
	deco(rightArm, "cyl", "ShieldBoss", Vector3.new(0.12, 0.62, 0.62), shield * at(0.11, 0, 0), C.Iron, M.Metal)
	for i = 0, 3 do
		local a = i / 4 * math.pi * 2 + math.pi / 4
		deco(rightArm, "ball", "Rivet", Vector3.new(0.09, 0.09, 0.09), shield * CFrame.Angles(a, 0, 0) * at(0.18, 0.22, 0), C.IronDark, M.Metal)
	end
	cone(rightArm, "ShieldSpike", shield * at(0.17, 0, 0) * CFrame.Angles(0, -math.pi / 2, 0), 0.75, 0.3, C.Iron, M.Metal, 6)

	--------------------------------------------------------------------------
	-- Legs: leather trousers, folded boots
	--------------------------------------------------------------------------
	for _, side in { -1, 1 } do
		local prefix = side < 0 and "Left" or "Right"
		local x = side * 0.4

		local upperLeg = newPart("ball", prefix .. "UpperLeg", Vector3.new(0.6, 0.9, 0.62), at(x, 1.3, 0), C.Pants, M.Leather)
		joint(prefix .. "Hip", lowerTorso, upperLeg, at(side * 0.38, 1.68, 0))

		local lowerLeg = newPart("ball", prefix .. "LowerLeg", Vector3.new(0.48, 0.72, 0.5), at(x, 0.68, 0.02), C.Pants, M.Leather)
		joint(prefix .. "Knee", upperLeg, lowerLeg, at(x, 0.98, 0))
		deco(lowerLeg, "ball", "Boot", Vector3.new(0.64, 0.6, 0.66), at(x, 0.55, 0), C.Boot, M.Leather)
		deco(lowerLeg, "ball", "BootCuff", Vector3.new(0.74, 0.22, 0.76), at(x, 0.8, 0) * CFrame.Angles(0.12, 0, 0), C.Boot, M.Leather)
		deco(lowerLeg, "ball", "BootStrap", Vector3.new(0.67, 0.08, 0.69), at(x, 0.48, 0), C.LeatherDark, M.Leather)

		local foot = newPart("ball", prefix .. "Foot", Vector3.new(0.6, 0.46, 1.0), at(x, 0.24, -0.2), C.Boot, M.Leather)
		joint(prefix .. "Ankle", lowerLeg, foot, at(x, 0.36, 0))
		deco(foot, "ball", "Sole", Vector3.new(0.64, 0.16, 1.04), at(x, 0.08, -0.2), C.Sole, M.Leather)
		deco(foot, "ball", "ToeSeam", Vector3.new(0.5, 0.1, 0.36), at(x, 0.36, -0.46) * CFrame.Angles(-0.4, 0, 0), C.LeatherDark, M.Leather)
	end

	--------------------------------------------------------------------------
	-- Humanoid
	--------------------------------------------------------------------------
	local humanoid = Instance.new("Humanoid")
	humanoid.RigType = Enum.HumanoidRigType.R15
	humanoid.HipHeight = 1.1 * S -- root bottom (y = 1.1) to the ground
	humanoid.AutomaticScalingEnabled = false
	humanoid.BreakJointsOnDeath = false -- the spawner ragdolls the goblin instead
	humanoid.RequiresNeck = false
	humanoid.DisplayName = "Jade Goblin"
	humanoid.HealthDisplayType = Enum.HumanoidHealthDisplayType.DisplayWhenDamaged
	humanoid.NameDisplayDistance = 60
	humanoid.HealthDisplayDistance = 60
	humanoid.Parent = model

	return model
end

return GoblinBuilder
]]></ProtectedString>
			</Properties>
		</Item>
		<Item class="ModuleScript" referent="RBX3">
			<Properties>
				<string name="Name">GoblinAnimator</string>
				<ProtectedString name="Source"><![CDATA[--[[
	GoblinAnimator

	Procedural animation for goblins built by GoblinBuilder. Runs on each
	client and writes Motor6D.Transform every frame, so it's smooth and costs
	the server nothing.

	It blends between:
	  - idle:   crouched breathing, sword raised, looking around, ear twitches
	  - run:    full stride cycle with knee tuck, push-off, body bob, lean,
	            hip/shoulder counter-twist, swinging arms, flopping ears and
	            loincloth; it slows to a walk at low speed
	  - air:    legs tucked while jumping/falling
	  - attack: overhead scimitar slash (model attribute "AttackStart")
	  - hurt:   head-and-body flinch (model attribute "HurtStart")

	Sign conventions (see GoblinBuilder): +X swings a limb forward, -X leans
	the body forward, +Z raises the right side, Y twists.
]]

local GoblinAnimator = {}

local TAU = math.pi * 2

local JOINTS = {
	"Root", "Waist", "Neck", "LeftEar", "RightEar",
	"LeftShoulder", "RightShoulder", "LeftElbow", "RightElbow",
	"LeftHip", "RightHip", "LeftKnee", "RightKnee", "LeftAnkle", "RightAnkle",
	"FrontFlap", "BackFlap",
}

local function lerp(a, b, t)
	return a + (b - a) * t
end

local function smooth(t)
	t = math.clamp(t, 0, 1)
	return t * t * (3 - 2 * t)
end

-- Sword swing keyframes: shoulder pitch, shoulder roll, elbow, waist twist, waist lean.
local READY = { 0.45, -0.2, 0.95, 0, 0 }
local WINDUP = { 2.8, -0.45, 1.7, 0.5, 0.08 }
local STRIKE = { 0.15, 0.25, 0.1, -0.55, -0.32 }

local function attackPose(u)
	local pose = table.create(5)
	local weight
	if u < 0.38 then
		local k = smooth(u / 0.38)
		for i = 1, 5 do
			pose[i] = lerp(READY[i], WINDUP[i], k)
		end
		weight = smooth(u / 0.1)
	elseif u < 0.58 then
		local k = (u - 0.38) / 0.2
		k = k * k -- accelerate into the hit
		for i = 1, 5 do
			pose[i] = lerp(WINDUP[i], STRIKE[i], k)
		end
		weight = 1
	else
		for i = 1, 5 do
			pose[i] = STRIKE[i]
		end
		weight = 1 - smooth((u - 0.58) / 0.42)
	end
	return pose, weight
end

function GoblinAnimator.new(model, config)
	local root = model:FindFirstChild("HumanoidRootPart")
	if not root then
		return nil
	end
	local motors = {}
	for _, d in model:GetDescendants() do
		if d:IsA("Motor6D") then
			motors[d.Name] = d
		end
	end
	for _, name in JOINTS do
		if not motors[name] then
			return nil
		end
	end
	local seed = math.random() * 100
	return {
		model = model,
		root = root,
		motors = motors,
		scale = model:GetAttribute("Scale") or 1,
		runSpeed = config.ChaseSpeed,
		attackDuration = config.AttackDuration,
		seed = seed,
		t = seed,
		phase = 0,
		move = 0,
		air = 0,
		twitchAt = seed + 1 + math.random() * 3,
		twitchStart = -math.huge,
		twitchSide = 1,
	}
end

-- grounded: whether the goblin is standing on something (the client raycasts for this).
function GoblinAnimator.step(rig, dt, serverNow, grounded)
	local motors = rig.motors
	local vel = rig.root.AssemblyLinearVelocity
	local speed = Vector2.new(vel.X, vel.Z).Magnitude
	local S = rig.scale

	rig.t += dt
	local t = rig.t

	-- Smoothed 0..1 "how much running" and "how much in the air".
	local moveTarget = math.clamp(speed / rig.runSpeed, 0, 1)
	rig.move += (moveTarget - rig.move) * math.min(1, dt * 7)
	local airTarget = (not grounded and math.abs(vel.Y) > 1) and 1 or 0
	rig.air += (airTarget - rig.air) * math.min(1, dt * 10)
	local m = rig.move * (1 - rig.air)
	local idle = (1 - rig.move) * (1 - rig.air)
	local air = rig.air

	-- Stride cycle: faster steps at higher speed, scaled for leg length.
	local strides = 0.9 + (speed / S) * 0.12
	if rig.move > 0.02 then
		rig.phase = (rig.phase + dt * strides * TAU) % TAU
	end
	local p = rig.phase
	local s, c = math.sin(p), math.cos(p)
	local bounce = math.sin(p * 2 - 1.0)
	local breath = math.sin(t * 2.2)

	-- Idle look-around and ear twitches.
	local lookYaw = 0.4 * math.sin(t * 0.45) * math.sin(t * 0.23 + 1.3)
	local lookPitch = 0.08 * math.sin(t * 0.37 + 2)
	if t >= rig.twitchAt then
		rig.twitchStart = t
		rig.twitchAt = t + 1.5 + math.random() * 4
		rig.twitchSide = -rig.twitchSide
	end
	local twitch = 0
	local tw = t - rig.twitchStart
	if tw < 0.25 then
		twitch = math.sin(tw / 0.25 * math.pi) * 0.35 * idle
	end

	-- Body: lean into the run, bob up at each push-off, twist with the hips.
	local lean = 0.32 * m
	local bob = (m * (0.16 * math.abs(s) - 0.06) - idle * 0.04 + idle * 0.012 * breath + air * 0.05) * S
	local rootPitch, rootYaw, rootRoll = -lean, -0.16 * s * m, 0.05 * s * m
	local waistPitch, waistYaw = -0.08 * m + 0.03 * breath * idle, 0.3 * s * m
	local neckPitch = lean * 0.8 + 0.05 * bounce * m + lookPitch * idle
	local neckYaw = lookYaw * idle - 0.15 * s * m

	-- Legs. side: -1 left, +1 right. The left leg leads when s > 0.
	local legs = {}
	for _, side in { -1, 1 } do
		local ls, lc = -side * s, -side * c
		local hip = lean + 0.95 * ls * m + 0.18 * idle + 0.7 * air
		local knee = -(m * (0.35 + 1.25 * ((1 + lc) / 2) ^ 2) + 0.36 * idle + 1.1 * air)
		-- Keep the foot roughly flat on the ground, and point the toes as it pushes off.
		local ankle = (lean - hip - knee) * 0.75 * (m + idle) - 0.35 * m * math.max(0, -ls) + 0.3 * air
		legs[side] = { hip, knee, ankle }
	end

	-- Arms. The sword arm swings opposite the left leg; the shield arm stays guarded.
	local lsPitch = idle * (0.45 + 0.04 * breath) + m * (0.35 - 0.55 * s) + air * 0.9
	local lsRoll = -(idle * 0.2 + m * 0.22 + air * 0.5)
	local lElbow = idle * 0.95 + m * (1.15 - 0.1 * s) + air * 1.0
	local rsPitch = idle * (0.25 + 0.03 * breath) + m * (0.3 + 0.25 * s) + air * 0.5
	local rsRoll = idle * 0.18 + m * 0.2 + air * 0.6
	local rElbow = idle * 0.35 + m * 0.5 + air * 0.4

	-- Sword attack overrides the sword arm and waist.
	local attackStart = rig.model:GetAttribute("AttackStart")
	if attackStart then
		local u = (serverNow - attackStart) / rig.attackDuration
		if u >= 0 and u < 1 then
			local pose, w = attackPose(u)
			lsPitch = lerp(lsPitch, pose[1], w)
			lsRoll = lerp(lsRoll, pose[2], w)
			lElbow = lerp(lElbow, pose[3], w)
			waistYaw = lerp(waistYaw, pose[4], w)
			waistPitch += pose[5] * w
		end
	end

	-- Flinch when hit.
	local hurtStart = rig.model:GetAttribute("HurtStart")
	if hurtStart then
		local u = (serverNow - hurtStart) / 0.35
		if u >= 0 and u < 1 then
			local k = math.sin(u * math.pi)
			neckPitch += 0.35 * k
			waistPitch += 0.2 * k
			rsPitch += 0.4 * k
		end
	end

	-- Ears flop with each bounce, sweep back in the wind, and twitch at rest.
	local earFlop = 0.14 * m * bounce + 0.04 * idle * breath - 0.2 * air
	local earSweep = 0.3 * m

	-- Loincloth: the front flap is kicked by whichever leg is forward, the back trails.
	local frontFlap = m * (0.12 + 0.45 * math.abs(s)) + air * 0.4
	local backFlap = -m * (0.45 + 0.12 * math.sin(p * 2)) - air * 0.3

	local CF, A = CFrame.new, CFrame.Angles
	motors.Root.Transform = CF(0, bob, 0) * A(rootPitch, rootYaw, rootRoll)
	motors.Waist.Transform = A(waistPitch, waistYaw, 0)
	motors.Neck.Transform = A(neckPitch, neckYaw, 0)
	motors.LeftEar.Transform = A(0.05 * m * bounce, earSweep, -(earFlop + (rig.twitchSide < 0 and twitch or 0)))
	motors.RightEar.Transform = A(0.05 * m * bounce, -earSweep, earFlop + (rig.twitchSide > 0 and twitch or 0))
	motors.LeftShoulder.Transform = A(lsPitch, 0, lsRoll)
	motors.RightShoulder.Transform = A(rsPitch, 0, rsRoll)
	motors.LeftElbow.Transform = A(lElbow, 0, 0)
	motors.RightElbow.Transform = A(rElbow, 0, 0)
	motors.LeftHip.Transform = A(legs[-1][1], 0, -0.05)
	motors.RightHip.Transform = A(legs[1][1], 0, 0.05)
	motors.LeftKnee.Transform = A(legs[-1][2], 0, 0)
	motors.RightKnee.Transform = A(legs[1][2], 0, 0)
	motors.LeftAnkle.Transform = A(legs[-1][3], 0, 0)
	motors.RightAnkle.Transform = A(legs[1][3], 0, 0)
	motors.FrontFlap.Transform = A(frontFlap, 0, 0)
	motors.BackFlap.Transform = A(backFlap, 0, 0)
end

return GoblinAnimator
]]></ProtectedString>
			</Properties>
		</Item>
		<Item class="Script" referent="RBX4">
			<Properties>
				<string name="Name">GoblinSpawner</string>
				<token name="RunContext">1</token>
				<ProtectedString name="Source"><![CDATA[--[[
	Spawns Jade Jungle goblins and runs their AI: wander around their spawn
	point, chase nearby players, slash them with the scimitar, ragdoll on death
	and respawn later. This is a Script with RunContext = Server, so it runs
	from ReplicatedStorage.
]]

local CollectionService = game:GetService("CollectionService")
local PhysicsService = game:GetService("PhysicsService")
local Players = game:GetService("Players")
local Workspace = game:GetService("Workspace")

local folder = script.Parent
local Config = require(folder:WaitForChild("Config"))
local GoblinBuilder = require(folder:WaitForChild("GoblinBuilder"))

local rng = Random.new()

local goblinFolder = Workspace:FindFirstChild("JadeGoblins") or Instance.new("Folder")
goblinFolder.Name = "JadeGoblins"
goblinFolder.Parent = Workspace

-- Ragdoll pieces collide with the world but not with each other.
local RAGDOLL_GROUP = "JadeGoblinRagdoll"
pcall(function()
	PhysicsService:RegisterCollisionGroup(RAGDOLL_GROUP)
	PhysicsService:CollisionGroupSetCollidable(RAGDOLL_GROUP, RAGDOLL_GROUP, false)
end)

local rayParams = RaycastParams.new()
rayParams.FilterType = Enum.RaycastFilterType.Exclude
rayParams.IgnoreWater = true

local function groundAt(position)
	local ignore = { goblinFolder }
	for _, player in Players:GetPlayers() do
		if player.Character then
			table.insert(ignore, player.Character)
		end
	end
	rayParams.FilterDescendantsInstances = ignore
	local result = Workspace:Raycast(position + Vector3.new(0, 40, 0), Vector3.new(0, -200, 0), rayParams)
	return result and result.Position or position
end

local function flat(v)
	return Vector3.new(v.X, 0, v.Z)
end

local function findTarget(position, home)
	local best, bestRoot, bestDist = nil, nil, Config.AggroRange
	for _, player in Players:GetPlayers() do
		local character = player.Character
		local humanoid = character and character:FindFirstChildOfClass("Humanoid")
		local root = character and character:FindFirstChild("HumanoidRootPart")
		if humanoid and root and humanoid.Health > 0 then
			local dist = (root.Position - position).Magnitude
			if dist < bestDist and (root.Position - home).Magnitude <= Config.LeashRange then
				best, bestRoot, bestDist = humanoid, root, dist
			end
		end
	end
	return best, bestRoot, bestDist
end

local function ragdoll(model)
	model:SetAttribute("Dead", true)
	CollectionService:RemoveTag(model, Config.Tag)
	local root = model:FindFirstChild("HumanoidRootPart")
	local humanoid = model:FindFirstChildOfClass("Humanoid")
	if humanoid then
		humanoid.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.None
	end

	for _, motor in model:GetDescendants() do
		if motor:IsA("Motor6D") then
			if motor.Name == "Root" then
				motor:Destroy()
			else
				-- Point each socket's limit cone along the limb so the rest pose is inside it.
				local name = motor.Name
				local axis
				if name == "Waist" or name == "Neck" then
					axis = CFrame.Angles(0, 0, math.pi / 2)
				elseif name == "LeftEar" then
					axis = CFrame.Angles(0, math.pi, 0)
				elseif name == "RightEar" then
					axis = CFrame.identity
				else
					axis = CFrame.Angles(0, 0, -math.pi / 2)
				end
				local a0 = Instance.new("Attachment")
				a0.CFrame = motor.C0 * axis
				a0.Parent = motor.Part0
				local a1 = Instance.new("Attachment")
				a1.CFrame = motor.C1 * axis
				a1.Parent = motor.Part1
				local socket = Instance.new("BallSocketConstraint")
				socket.Attachment0 = a0
				socket.Attachment1 = a1
				socket.LimitsEnabled = true
				socket.UpperAngle = 50
				socket.TwistLimitsEnabled = true
				socket.TwistLowerAngle = -30
				socket.TwistUpperAngle = 30
				socket.Parent = motor.Part1
				motor.Enabled = false
			end
		end
	end

	for _, part in model:GetDescendants() do
		if part:IsA("BasePart") and part ~= root then
			part.CollisionGroup = RAGDOLL_GROUP
			-- Body segments (the ones holding a joint) give the ragdoll weight and collision.
			if part:FindFirstChildOfClass("Motor6D") or part.Name == "LowerTorso" then
				part.CanCollide = true
				part.Massless = false
			end
		end
	end
	if root then
		root.Anchored = true
		root.CanCollide = false
	end

	local torso = model:FindFirstChild("UpperTorso")
	if torso and root then
		torso:ApplyImpulse((root.CFrame.LookVector * -6 + Vector3.new(0, 4, 0)) * torso.AssemblyMass)
	end
end

local function attack(model, root, targetHumanoid, targetRoot)
	model:SetAttribute("AttackStart", Workspace:GetServerTimeNow())
	-- Deal damage when the blade comes down, if the target is still in reach.
	task.delay(Config.AttackDuration * 0.5, function()
		local humanoid = model:FindFirstChildOfClass("Humanoid")
		if not model.Parent or not humanoid or humanoid.Health <= 0 then
			return
		end
		if targetHumanoid.Health > 0 and (targetRoot.Position - root.Position).Magnitude <= Config.AttackRange + 2 then
			targetHumanoid:TakeDamage(Config.AttackDamage)
		end
	end)
end

local function runBrain(model, home)
	local humanoid = model:FindFirstChildOfClass("Humanoid")
	local root = model.PrimaryPart
	local lastAttack = 0
	local wanderGoal = nil
	local idleUntil = os.clock() + rng:NextNumber(0, 3)
	local stuckTime = 0
	local lastPos = root.Position

	while model.Parent and humanoid.Health > 0 do
		local dt = task.wait(Config.ThinkInterval)
		if not model.Parent or humanoid.Health <= 0 then
			break
		end
		local pos = root.Position
		local targetHumanoid, targetRoot, dist = findTarget(pos, home)

		if targetRoot then
			wanderGoal = nil
			humanoid.WalkSpeed = Config.ChaseSpeed
			if dist > Config.AttackRange then
				humanoid:MoveTo(targetRoot.Position)
			else
				humanoid:MoveTo(pos)
				local look = Vector3.new(targetRoot.Position.X, pos.Y, targetRoot.Position.Z)
				if (look - pos).Magnitude > 0.1 then
					root.CFrame = CFrame.lookAt(pos, look)
				end
				if os.clock() - lastAttack >= Config.AttackCooldown then
					lastAttack = os.clock()
					attack(model, root, targetHumanoid, targetRoot)
				end
			end
		else
			humanoid.WalkSpeed = Config.WanderSpeed
			if flat(pos - home).Magnitude > Config.WanderRadius * 1.5 then
				wanderGoal = home -- wandered or chased too far: head back
			end
			if wanderGoal then
				if flat(wanderGoal - pos).Magnitude < 2.5 then
					wanderGoal = nil
					idleUntil = os.clock() + rng:NextNumber(1.5, 5)
					humanoid:MoveTo(pos)
				else
					humanoid:MoveTo(wanderGoal)
				end
			elseif os.clock() >= idleUntil then
				local angle = rng:NextNumber(0, math.pi * 2)
				local radius = rng:NextNumber(4, Config.WanderRadius)
				wanderGoal = groundAt(home + Vector3.new(math.cos(angle) * radius, 0, math.sin(angle) * radius))
			end
		end

		-- Jump over roots and rocks; give up on a wander goal we can't reach.
		if humanoid.MoveDirection.Magnitude > 0.1 and flat(pos - lastPos).Magnitude < humanoid.WalkSpeed * dt * 0.25 then
			stuckTime += dt
			if stuckTime > 0.6 then
				humanoid.Jump = true
				stuckTime = 0
				if not targetRoot and wanderGoal ~= home then
					wanderGoal = nil
				end
			end
		else
			stuckTime = 0
		end
		lastPos = pos
	end
end

local function spawnGoblin(home)
	local model = GoblinBuilder.build({ scale = Config.Scale, random = rng })
	local humanoid = model:FindFirstChildOfClass("Humanoid")
	humanoid.MaxHealth = Config.MaxHealth
	humanoid.Health = Config.MaxHealth
	humanoid.WalkSpeed = Config.WanderSpeed

	model:PivotTo(CFrame.new(groundAt(home)) * CFrame.Angles(0, rng:NextNumber(0, math.pi * 2), 0))
	model.ModelStreamingMode = Enum.ModelStreamingMode.Atomic
	model.Parent = goblinFolder
	model.PrimaryPart:SetNetworkOwner(nil)

	for _, state in {
		Enum.HumanoidStateType.Climbing,
		Enum.HumanoidStateType.FallingDown,
		Enum.HumanoidStateType.Ragdoll,
		Enum.HumanoidStateType.Seated,
	} do
		humanoid:SetStateEnabled(state, false)
	end

	local lastHealth = humanoid.Health
	humanoid.HealthChanged:Connect(function(health)
		if health < lastHealth and health > 0 then
			model:SetAttribute("HurtStart", Workspace:GetServerTimeNow())
		end
		lastHealth = health
	end)

	CollectionService:AddTag(model, Config.Tag)
	task.spawn(runBrain, model, home)
	return model, humanoid
end

-- One "slot" per goblin: keep it alive, and respawn it after it dies.
local function runSlot(home)
	while true do
		local model, humanoid = spawnGoblin(home)
		humanoid.Died:Wait()
		ragdoll(model)
		task.delay(Config.CorpseTime, function()
			model:Destroy()
		end)
		task.wait(Config.RespawnTime)
	end
end

local function findSpawnPoints()
	local node = Workspace
	for _, name in Config.SpawnFolderPath do
		node = node and node:FindFirstChild(name)
	end
	local points = {}
	if node then
		for _, part in node:GetDescendants() do
			if part:IsA("BasePart") then
				table.insert(points, part.Position)
			end
		end
	end
	if #points == 0 then
		warn(`[JadeGoblins] No spawn Parts found in Workspace.{table.concat(Config.SpawnFolderPath, ".")}; spawning around FallbackCenter.`)
		for _ = 1, Config.FallbackCount do
			local angle = rng:NextNumber(0, math.pi * 2)
			local radius = rng:NextNumber(0, Config.FallbackRadius)
			table.insert(points, Config.FallbackCenter + Vector3.new(math.cos(angle) * radius, 0, math.sin(angle) * radius))
		end
	end
	return points
end

local total = 0
for _, home in findSpawnPoints() do
	for _ = 1, Config.GoblinsPerSpawn do
		if total >= Config.MaxGoblins then
			break
		end
		total += 1
		task.spawn(runSlot, home)
	end
end
]]></ProtectedString>
			</Properties>
		</Item>
		<Item class="Script" referent="RBX5">
			<Properties>
				<string name="Name">GoblinAnimate</string>
				<token name="RunContext">2</token>
				<ProtectedString name="Source"><![CDATA[--[[
	Animates every Jade Jungle goblin on this client.
	This is a Script with RunContext = Client, so it runs from ReplicatedStorage.
]]

local CollectionService = game:GetService("CollectionService")
local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")

local folder = script.Parent
local Config = require(folder:WaitForChild("Config"))
local GoblinAnimator = require(folder:WaitForChild("GoblinAnimator"))

local rigs = {}

local function track(model)
	if rigs[model] or not model:IsA("Model") then
		return
	end
	-- Goblins stream in atomically, but wait briefly in case parts arrive late.
	if not model:FindFirstChild("HumanoidRootPart") then
		model:WaitForChild("HumanoidRootPart", 5)
	end
	local rig = GoblinAnimator.new(model, Config)
	if rig and model.Parent and CollectionService:HasTag(model, Config.Tag) then
		local params = RaycastParams.new()
		params.FilterType = Enum.RaycastFilterType.Exclude
		params.FilterDescendantsInstances = { model }
		params.IgnoreWater = true
		rig.groundParams = params
		-- Root centre is 2 units above the feet; allow a little slack for slopes.
		rig.groundRay = Vector3.new(0, -2.6 * rig.scale, 0)
		rigs[model] = rig
	end
end

CollectionService:GetInstanceAddedSignal(Config.Tag):Connect(function(model)
	task.spawn(track, model)
end)
CollectionService:GetInstanceRemovedSignal(Config.Tag):Connect(function(model)
	rigs[model] = nil
end)
for _, model in CollectionService:GetTagged(Config.Tag) do
	task.spawn(track, model)
end

RunService.PreSimulation:Connect(function(dt)
	local camera = Workspace.CurrentCamera
	local eye = camera and camera.CFrame.Position
	local now = Workspace:GetServerTimeNow()
	for model, rig in rigs do
		if not model.Parent or model:GetAttribute("Dead") then
			rigs[model] = nil
		elseif not eye or (rig.root.Position - eye).Magnitude <= Config.AnimateDistance then
			local grounded = Workspace:Raycast(rig.root.Position, rig.groundRay, rig.groundParams) ~= nil
			GoblinAnimator.step(rig, dt, now, grounded)
		end
	end
end)
]]></ProtectedString>
